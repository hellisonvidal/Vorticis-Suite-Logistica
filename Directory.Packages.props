<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="MiniExcel" Version="1.46.0" />
    <PackageVersion Include="Npgsql" Version="10.0.1" />
    <PackageVersion Include="PDFsharp-MigraDoc" Version="6.2.4" />
    <PackageVersion Include="PdfPig" Version="0.1.11" />
    <!-- O PDFsharp depende de System.Security.Cryptography.Pkcs 8.0.1 (vulnerável: GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx); fixado na versão corrigida 10.0.13 (feed de vulnerabilidades do NuGet: afetadas 10.0.0–10.0.12). -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.11" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.13" />
    <PackageVersion Include="Avalonia" Version="11.3.20" />
    <PackageVersion Include="Avalonia.Desktop" Version="11.3.20" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="11.3.20" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="11.3.20" />
    <PackageVersion Include="Avalonia.Controls.DataGrid" Version="11.3.13" />
    <PackageVersion Include="Avalonia.Headless" Version="11.3.20" />
    <PackageVersion Include="Avalonia.ReactiveUI" Version="11.3.20" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageVersion Include="Material.Avalonia" Version="3.6.0" />
    <PackageVersion Include="Material.Icons.Avalonia" Version="3.6.0" />
    <PackageVersion Include="Material.Dialogs.Avalonia" Version="3.6.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>
