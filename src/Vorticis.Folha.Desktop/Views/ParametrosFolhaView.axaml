<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Vorticis.Desktop.Comum.Views"
             xmlns:vm="using:Vorticis.Folha.Desktop.ViewModels"
             x:Class="Vorticis.Folha.Desktop.Views.ParametrosFolhaView"
             x:DataType="vm:ParametrosFolhaViewModel">
  <Grid ColumnDefinitions="440,16,*" Margin="8">
    <ScrollViewer>
      <StackPanel Spacing="6">
        <TextBlock Classes="titulo" Text="Parâmetros de encargos e eSocial" />
        <TextBlock Text="Seu perfil permite apenas consultar." Classes="erro" IsVisible="{Binding !PodeEditar}" />
        <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
          <TextBlock Classes="rotulo" Text="RAT (grau de risco)" />
          <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:ParametrosFolhaViewModel.GrausRat}" SelectedItem="{Binding Rat}" IsEnabled="{Binding PodeEditar}" Width="220" />
          <TextBlock Grid.Row="1" Classes="rotulo" Text="FAP" />
          <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Fap}" IsEnabled="{Binding PodeEditar}" Width="120" HorizontalAlignment="Left" ToolTip.Tip="0,5000 a 2,0000" />
          <TextBlock Grid.Row="2" Classes="rotulo" Text="Terceiros (%)" />
          <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Terceiros}" IsEnabled="{Binding PodeEditar}" Width="120" HorizontalAlignment="Left" />
          <TextBlock Grid.Row="3" Classes="rotulo" Text="FPAS / cód. terceiros" />
          <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="6">
            <TextBox Text="{Binding Fpas}" IsEnabled="{Binding PodeEditar}" Width="80" MaxLength="3" />
            <TextBox Text="{Binding CodTerceiros}" IsEnabled="{Binding PodeEditar}" Width="90" MaxLength="4" />
          </StackPanel>
          <TextBlock Grid.Row="4" Classes="rotulo" Text="Simples Nacional" />
          <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{x:Static vm:ParametrosFolhaViewModel.Anexos}" SelectedItem="{Binding Anexo}" IsEnabled="{Binding PodeEditar}" Width="280" />
          <TextBlock Grid.Row="5" Classes="rotulo" Text="Classif. tributária" />
          <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding ClassTrib}" IsEnabled="{Binding PodeEditar}" Width="80" HorizontalAlignment="Left" MaxLength="2" ToolTip.Tip="Tabela 08 do eSocial (99 = pessoas jurídicas em geral)" />
          <TextBlock Grid.Row="6" Classes="rotulo" Text="Responsável (S-1299)" />
          <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding ResponsavelNome}" IsEnabled="{Binding PodeEditar}" />
          <TextBlock Grid.Row="7" Classes="rotulo" Text="CPF do responsável" />
          <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding ResponsavelCpf}" IsEnabled="{Binding PodeEditar}" Width="160" HorizontalAlignment="Left" />
          <TextBlock Grid.Row="8" Classes="rotulo" Text="E-mail" />
          <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding ResponsavelEmail}" IsEnabled="{Binding PodeEditar}" />
          <TextBlock Grid.Row="9" Classes="rotulo" Text="Telefone" />
          <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding ResponsavelTelefone}" IsEnabled="{Binding PodeEditar}" Width="160" HorizontalAlignment="Left" />
          <Button Grid.Row="10" Grid.Column="1" Content="Gravar parâmetros" Command="{Binding SalvarCommand}" Classes="accent" IsEnabled="{Binding PodeEditar}" HorizontalAlignment="Left" />
        </Grid>
        <TextBlock FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                   Text="Empresa do Simples Nacional: anexos I, II, III e V não pagam a CPP (20% + RAT + terceiros) pela folha; o anexo IV paga 20% + RAT, sem terceiros. O regime vem do cadastro da empresa. O FGTS (8%) incide sempre." />
        <c:MensagensView />
      </StackPanel>
    </ScrollViewer>
    <DockPanel Grid.Column="2">
      <TextBlock DockPanel.Dock="Top" Classes="titulo" Text="Tabelas legais por vigência" Margin="0,0,0,8" />
      <TextBlock DockPanel.Dock="Bottom" FontSize="11" Foreground="Gray" TextWrapping="Wrap" Margin="0,6,0,0"
                 Text="Valores gravados em core.parametro_legal: nada de valor legal fica no código. Para uma nova vigência (ex.: INSS e IRRF de 2027), inclua a linha com a data de início." />
      <DataGrid ItemsSource="{Binding Tabelas}" IsReadOnly="True" AutoGenerateColumns="False">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Tabela" Binding="{ReflectionBinding Tabela}" Width="140" />
          <DataGridTextColumn Header="Vigência" Binding="{ReflectionBinding Vigencia}" Width="190" />
          <DataGridTextColumn Header="Fundamento legal" Binding="{ReflectionBinding Fundamento}" Width="*" />
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>
  </Grid>
</UserControl>
