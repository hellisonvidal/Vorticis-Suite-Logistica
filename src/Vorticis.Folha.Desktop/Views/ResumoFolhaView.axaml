<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Vorticis.Desktop.Comum.Views"
             xmlns:vm="using:Vorticis.Folha.Desktop.ViewModels"
             xmlns:v="using:Vorticis.Folha.Desktop.Views"
             x:Class="Vorticis.Folha.Desktop.Views.ResumoFolhaView"
             x:DataType="vm:ResumoFolhaViewModel">
  <DockPanel Margin="8">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
      <TextBlock Classes="titulo" Text="Resumo da folha" VerticalAlignment="Center" />
      <TextBlock Text="Competência" VerticalAlignment="Center" />
      <c:SeletorCompetencia Competencia="{Binding Competencia}" />
      <Button Content="Gerar" Command="{Binding GerarCommand}" Classes="accent" />
      <Rectangle Width="1" Fill="#D0D5DD" Margin="6,4" />
      <c:BarraExportacaoView />
    </StackPanel>
    <c:MensagensView DockPanel.Dock="Bottom" />
    <Grid RowDefinitions="*,8,*">
      <v:TabelaRelatorioGrid Tabela="{Binding Tabela}" />
      <v:TabelaRelatorioGrid Grid.Row="2" Tabela="{Binding Tabela2}" />
    </Grid>
  </DockPanel>
</UserControl>
