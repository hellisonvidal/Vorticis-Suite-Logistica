<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Vorticis.Desktop.Comum.Views"
             xmlns:vm="using:Vorticis.Folha.Desktop.ViewModels"
             x:Class="Vorticis.Folha.Desktop.Views.ContabilizacaoFolhaView"
             x:DataType="vm:ContabilizacaoFolhaViewModel">
  <Grid ColumnDefinitions="*,16,420" RowDefinitions="Auto,*,Auto" Margin="8">
    <StackPanel Grid.ColumnSpan="3" Spacing="6" Margin="0,0,0,8">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Classes="titulo" Text="Contabilização da folha" VerticalAlignment="Center" />
        <TextBlock Text="Competência" VerticalAlignment="Center" />
        <c:SeletorCompetencia Competencia="{Binding Competencia}" />
        <Button Content="Prévia da folha" Command="{Binding PreviaFolhaCommand}" IsEnabled="{Binding PodeContabilizar}" />
        <Button Content="Contabilizar folha" Command="{Binding ContabilizarFolhaCommand}" Classes="accent" IsEnabled="{Binding PodeContabilizar}" />
        <Rectangle Width="1" Fill="#D0D5DD" Margin="6,4" />
        <Button Content="Prévia das provisões" Command="{Binding PreviaProvisoesCommand}" IsEnabled="{Binding PodeContabilizar}" />
        <Button Content="Contabilizar provisões" Command="{Binding ContabilizarProvisoesCommand}" Classes="accent" IsEnabled="{Binding PodeContabilizar}" />
      </StackPanel>
      <TextBlock FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                 Text="A folha só é contabilizada com a competência fechada; o lançamento (origem FOLHA) vai para o último dia do mês pelo mesmo serviço de lançamentos do módulo contábil (valida contas, períodos e partidas dobradas). Para corrigir a folha, desfaça a contabilização (gera estorno), reabra a competência, ajuste e contabilize de novo." />
    </StackPanel>

    <DockPanel Grid.Row="1">
      <TextBlock DockPanel.Dock="Top" Text="Regras de contabilização (rubrica ou código especial → contas)" FontWeight="SemiBold" Foreground="#1F3A5F" Margin="0,0,0,4" />
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6" IsEnabled="{Binding PodeParametros}">
        <Button Content="Gerar regras sugeridas" Command="{Binding GerarSugeridasCommand}" />
        <CheckBox Content="Férias e 13º baixam a provisão (usa provisões)" IsChecked="{Binding ComProvisoes}" />
      </StackPanel>
      <DataGrid ItemsSource="{Binding Regras}" SelectedItem="{Binding RegraSelecionada}" IsReadOnly="True" AutoGenerateColumns="False">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Chave" Binding="{ReflectionBinding Chave}" Width="130" />
          <DataGridTextColumn Header="Descrição" Binding="{ReflectionBinding Descricao}" Width="*" />
          <DataGridTextColumn Header="Débito" Binding="{ReflectionBinding Debito}" Width="110" />
          <DataGridTextColumn Header="Crédito" Binding="{ReflectionBinding Credito}" Width="110" />
          <DataGridTextColumn Header="Centro de custo" Binding="{ReflectionBinding CentroCusto}" Width="110" />
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>
    <StackPanel Grid.Row="1" Grid.Column="2" Spacing="6" IsEnabled="{Binding PodeParametros}">
      <TextBlock Text="Regra" FontWeight="SemiBold" Foreground="#1F3A5F" />
      <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
        <TextBlock Classes="rotulo" Text="Chave" />
        <TextBox Grid.Column="1" Text="{Binding Chave}" Watermark="Código da rubrica (1000...) ou ENC_*, PROV_*" />
        <TextBlock Grid.Row="1" Classes="rotulo" Text="Descrição" />
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Descricao}" />
        <TextBlock Grid.Row="2" Classes="rotulo" Text="Conta débito" />
        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ContaDebito}" Watermark="Código no plano de contas" />
        <TextBlock Grid.Row="3" Classes="rotulo" Text="Conta crédito" />
        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ContaCredito}" Watermark="Código no plano de contas" />
        <CheckBox Grid.Row="4" Grid.Column="1" Content="Abrir por centro de custo do funcionário" IsChecked="{Binding UsaCentroCusto}" />
        <ComboBox Grid.Row="5" Grid.Column="1" ItemsSource="{x:Static vm:ContabilizacaoFolhaViewModel.Lados}" SelectedItem="{Binding Lado}" HorizontalAlignment="Stretch" />
      </Grid>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Gravar regra" Command="{Binding GravarRegraCommand}" Classes="accent" />
        <Button Content="Excluir" Command="{Binding ExcluirRegraCommand}" />
      </StackPanel>
      <TextBlock FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                 Text="Proventos: débito na despesa, crédito em salários a pagar. Descontos e retenções: débito em salários a pagar, crédito na obrigação (INSS, IRRF...). Chaves especiais: ENC_* (encargos patronais e FGTS) e PROV_* (provisões)." />
    </StackPanel>

    <Grid Grid.Row="2" Grid.ColumnSpan="3" ColumnDefinitions="*,16,*" Margin="0,8,0,0" Height="210">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding TotalPrevia}" FontWeight="SemiBold" Margin="0,0,0,4" />
        <ListBox ItemsSource="{Binding Previa}" FontFamily="Consolas, Menlo, monospace" FontSize="11" />
      </DockPanel>
      <DockPanel Grid.Column="2">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
          <TextBlock Text="Contabilizações" FontWeight="SemiBold" Foreground="#1F3A5F" VerticalAlignment="Center" />
          <Button Content="Desfazer selecionada" Command="{Binding DesfazerCommand}" IsEnabled="{Binding PodeContabilizar}" />
        </StackPanel>
        <c:MensagensView DockPanel.Dock="Bottom" />
        <DataGrid ItemsSource="{Binding Contabilizacoes}" SelectedItem="{Binding ContabilizacaoSelecionada}" IsReadOnly="True" AutoGenerateColumns="False">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Compet." Binding="{ReflectionBinding Competencia}" Width="80" />
            <DataGridTextColumn Header="Tipo" Binding="{ReflectionBinding Tipo}" Width="90" />
            <DataGridTextColumn Header="Lcto nº" Binding="{ReflectionBinding Lancamento}" Width="70" />
            <DataGridTextColumn Header="Valor" Binding="{ReflectionBinding Valor}" Width="110" />
            <DataGridTextColumn Header="Situação" Binding="{ReflectionBinding Situacao}" Width="*" />
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </Grid>
  </Grid>
</UserControl>
