<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Vorticis.Desktop.Comum.Views"
             xmlns:vm="using:Vorticis.Folha.Desktop.ViewModels"
             x:Class="Vorticis.Folha.Desktop.Views.CargosView"
             x:DataType="vm:CargosViewModel">
  <Grid ColumnDefinitions="*,16,340" RowDefinitions="Auto,*" Margin="8">
    <c:BarraCadastroView Grid.ColumnSpan="3" Margin="0,0,0,8" />
    <DockPanel Grid.Row="1" IsEnabled="{Binding !EmEdicao}">
      <TextBlock DockPanel.Dock="Top" Classes="titulo" Text="Cargos" Margin="0,0,0,8" />
      <DataGrid ItemsSource="{Binding Lista}" SelectedItem="{Binding Selecionado}" IsReadOnly="True" AutoGenerateColumns="False">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Código" Binding="{ReflectionBinding Codigo}" Width="120" />
          <DataGridTextColumn Header="Cargo" Binding="{ReflectionBinding Nome}" Width="*" />
          <DataGridTextColumn Header="CBO" Binding="{ReflectionBinding Cbo}" Width="90" />
          <DataGridTextColumn Header="Situação" Binding="{ReflectionBinding Situacao}" Width="100" />
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>
    <StackPanel Grid.Row="1" Grid.Column="2" Spacing="6">
      <TextBlock Text="Seu perfil permite apenas consultar." Classes="erro" IsVisible="{Binding !PodeEditar}" />
      <TextBlock Text="Cargo" FontWeight="SemiBold" Foreground="#1F3A5F" />
      <Grid ColumnDefinitions="80,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">
        <TextBlock Classes="rotulo" Text="Código" />
        <TextBox Grid.Column="1" Text="{Binding Codigo}" IsEnabled="{Binding EmEdicao}" MaxLength="20" />
        <TextBlock Grid.Row="1" Classes="rotulo" Text="Cargo" />
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Nome}" IsEnabled="{Binding EmEdicao}" />
        <TextBlock Grid.Row="2" Classes="rotulo" Text="CBO" />
        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Cbo}" IsEnabled="{Binding EmEdicao}" MaxLength="7" Watermark="6 dígitos (ex.: 252105)" />
        <CheckBox Grid.Row="3" Grid.Column="1" Content="Ativo" IsChecked="{Binding Ativo}" IsEnabled="{Binding EmEdicao}" />
      </Grid>
      <c:MensagensView />
    </StackPanel>
  </Grid>
</UserControl>
