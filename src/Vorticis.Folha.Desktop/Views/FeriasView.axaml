<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Vorticis.Desktop.Comum.Views"
             xmlns:vm="using:Vorticis.Folha.Desktop.ViewModels"
             xmlns:cad="using:Vorticis.Folha.Cadastros"
             x:Class="Vorticis.Folha.Desktop.Views.FeriasView"
             x:DataType="vm:FeriasViewModel">
  <Grid ColumnDefinitions="480,16,*" RowDefinitions="Auto,*" Margin="8">
    <TextBlock Grid.ColumnSpan="3" Classes="titulo" Text="Férias" Margin="0,0,0,8" />
    <ScrollViewer Grid.Row="1">
      <StackPanel Spacing="6">
        <TextBlock Text="Seu perfil não permite calcular férias." Classes="erro" IsVisible="{Binding !PodeCalcular}" />
        <TextBlock Text="Funcionário" FontWeight="SemiBold" Foreground="#1F3A5F" />
        <ComboBox ItemsSource="{Binding Funcionarios}" SelectedItem="{Binding Funcionario}" HorizontalAlignment="Stretch">
          <ComboBox.ItemTemplate><DataTemplate x:DataType="cad:Funcionario"><TextBlock Text="{Binding Nome}" /></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text="Períodos aquisitivos" FontWeight="SemiBold" Foreground="#1F3A5F" />
        <DataGrid ItemsSource="{Binding Saldos}" SelectedItem="{Binding SaldoSelecionado}" IsReadOnly="True" AutoGenerateColumns="False" Height="130">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Período aquisitivo" Binding="{ReflectionBinding Periodo}" Width="*" />
            <DataGridTextColumn Header="Concessivo" Binding="{ReflectionBinding Concessivo}" Width="120" />
            <DataGridTextColumn Header="Dias" Binding="{ReflectionBinding Dias}" Width="70" />
            <DataGridTextColumn Header="Situação" Binding="{ReflectionBinding Situacao}" Width="120" />
          </DataGrid.Columns>
        </DataGrid>
        <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="6" IsEnabled="{Binding PodeCalcular}">
          <TextBlock Classes="rotulo" Text="Início do gozo" />
          <CalendarDatePicker Grid.Column="1" SelectedDate="{Binding GozoInicio}" Width="160" HorizontalAlignment="Left" />
          <TextBlock Grid.Row="1" Classes="rotulo" Text="Dias de gozo" />
          <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding DiasGozo}" Minimum="5" Maximum="30" FormatString="0" Width="130" HorizontalAlignment="Left" />
          <TextBlock Grid.Row="2" Classes="rotulo" Text="Abono pecuniário (dias)" />
          <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding AbonoDias}" Minimum="0" Maximum="10" FormatString="0" Width="130" HorizontalAlignment="Left" />
          <TextBlock Grid.Row="3" Classes="rotulo" Text="Faltas injustificadas" />
          <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding Faltas}" Minimum="0" Maximum="60" FormatString="0" Width="130" HorizontalAlignment="Left" />
          <TextBlock Grid.Row="4" Classes="rotulo" Text="Pagamento" />
          <CalendarDatePicker Grid.Row="4" Grid.Column="1" SelectedDate="{Binding Pagamento}" Width="160" HorizontalAlignment="Left" />
        </Grid>
        <Button Content="Calcular férias" Command="{Binding CalcularCommand}" Classes="accent" IsEnabled="{Binding PodeCalcular}" HorizontalAlignment="Left" />
        <TextBlock FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                   Text="Dias de gozo + abono ≤ dias de direito (30, reduzidos pelas faltas injustificadas: 24, 18 ou 12). Valor = remuneração (salário + adicionais + média simples das variáveis dos últimos 12 meses) ÷ 30 x dias + 1/3 constitucional. O abono e seu 1/3 não têm INSS, IRRF nem FGTS. O pagamento deve ocorrer até o início do gozo." />
        <c:MensagensView />
      </StackPanel>
    </ScrollViewer>
    <DockPanel Grid.Row="1" Grid.Column="2">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
        <TextBlock Text="Férias calculadas" FontWeight="SemiBold" Foreground="#1F3A5F" VerticalAlignment="Center" />
        <Button Content="Recibo (PDF)" Command="{Binding ReciboCommand}" IsEnabled="{Binding PodeRelatorios}" />
        <Button Content="Cancelar férias" Command="{Binding CancelarCommand}" IsEnabled="{Binding PodeCalcular}" />
      </StackPanel>
      <DataGrid ItemsSource="{Binding Registros}" SelectedItem="{Binding RegistroSelecionado}" IsReadOnly="True" AutoGenerateColumns="False">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Funcionário" Binding="{ReflectionBinding Funcionario}" Width="*" />
          <DataGridTextColumn Header="Período aquisitivo" Binding="{ReflectionBinding Periodo}" Width="180" />
          <DataGridTextColumn Header="Gozo" Binding="{ReflectionBinding Gozo}" Width="140" />
          <DataGridTextColumn Header="Abono" Binding="{ReflectionBinding Abono}" Width="70" />
          <DataGridTextColumn Header="Pagamento" Binding="{ReflectionBinding Pagamento}" Width="90" />
          <DataGridTextColumn Header="Líquido" Binding="{ReflectionBinding Liquido}" Width="100" />
          <DataGridTextColumn Header="Situação" Binding="{ReflectionBinding Situacao}" Width="90" />
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>
  </Grid>
</UserControl>
