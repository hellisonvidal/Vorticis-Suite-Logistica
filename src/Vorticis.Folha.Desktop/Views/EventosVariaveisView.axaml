<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Vorticis.Desktop.Comum.Views"
             xmlns:vm="using:Vorticis.Folha.Desktop.ViewModels"
             xmlns:cad="using:Vorticis.Folha.Cadastros"
             x:Class="Vorticis.Folha.Desktop.Views.EventosVariaveisView"
             x:DataType="vm:EventosVariaveisViewModel">
  <DockPanel Margin="8">
    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Classes="titulo" Text="Eventos variáveis" VerticalAlignment="Center" />
        <TextBlock Text="Competência" VerticalAlignment="Center" />
        <c:SeletorCompetencia Competencia="{Binding Competencia}" />
        <TextBlock Text="{Binding Situacao}" VerticalAlignment="Center" Foreground="#44506A" />
      </StackPanel>
      <TextBlock Text="Seu perfil não permite lançar eventos." Classes="erro" IsVisible="{Binding !PodeLancar}" />
      <WrapPanel Orientation="Horizontal" IsEnabled="{Binding PodeLancar}">
        <StackPanel Margin="0,0,10,6" Spacing="2"><TextBlock Text="Funcionário" FontSize="11" />
          <ComboBox ItemsSource="{Binding Funcionarios}" SelectedItem="{Binding Funcionario}" Width="240">
            <ComboBox.ItemTemplate><DataTemplate x:DataType="cad:Funcionario"><TextBlock Text="{Binding Nome}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox></StackPanel>
        <StackPanel Margin="0,0,10,6" Spacing="2"><TextBlock Text="Rubrica" FontSize="11" />
          <ComboBox ItemsSource="{Binding Rubricas}" SelectedItem="{Binding Rubrica}" Width="280">
            <ComboBox.ItemTemplate><DataTemplate x:DataType="cad:Rubrica"><TextBlock Text="{Binding Descricao}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox></StackPanel>
        <StackPanel Margin="0,0,10,6" Spacing="2" IsVisible="{Binding PorReferencia}"><TextBlock Text="{Binding RotuloQuantidade}" FontSize="11" />
          <TextBox Text="{Binding Referencia}" Width="90" /></StackPanel>
        <StackPanel Margin="0,0,10,6" Spacing="2" IsVisible="{Binding !PorReferencia}"><TextBlock Text="Valor (R$)" FontSize="11" />
          <TextBox Text="{Binding Valor}" Width="120" /></StackPanel>
        <StackPanel Margin="0,0,10,6" Spacing="2"><TextBlock Text="Observação" FontSize="11" />
          <TextBox Text="{Binding Observacao}" Width="220" /></StackPanel>
        <Button Content="Lançar" Command="{Binding LancarCommand}" Classes="accent" VerticalAlignment="Bottom" Margin="0,0,8,6" />
        <Button Content="Excluir selecionado" Command="{Binding ExcluirCommand}" VerticalAlignment="Bottom" Margin="0,0,0,6" />
      </WrapPanel>
      <TextBlock FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                 Text="Horas extras 50%/100%, adicional noturno e faltas são lançados por quantidade; comissões, adiantamentos, vale-transporte, pensão alimentícia e outros por valor. O DSR, as faltas sobre o DSR, a insalubridade/periculosidade e o salário-família são calculados sozinhos. Depois de lançar, recalcule a folha mensal." />
    </StackPanel>
    <c:MensagensView DockPanel.Dock="Bottom" />
    <DataGrid ItemsSource="{Binding Eventos}" SelectedItem="{Binding Selecionado}" IsReadOnly="True" AutoGenerateColumns="False">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Funcionário" Binding="{ReflectionBinding Funcionario}" Width="220" />
        <DataGridTextColumn Header="Rubrica" Binding="{ReflectionBinding Rubrica}" Width="*" />
        <DataGridTextColumn Header="Quantidade" Binding="{ReflectionBinding Referencia}" Width="100" />
        <DataGridTextColumn Header="Valor" Binding="{ReflectionBinding Valor}" Width="120" />
        <DataGridTextColumn Header="Observação" Binding="{ReflectionBinding Observacao}" Width="240" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
