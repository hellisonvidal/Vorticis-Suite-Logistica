<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Vorticis.Desktop.Comum.Views"
             xmlns:vm="using:Vorticis.Folha.Desktop.ViewModels"
             x:Class="Vorticis.Folha.Desktop.Views.FolhaMensalView"
             x:DataType="vm:FolhaMensalViewModel">
  <DockPanel Margin="8">
    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
      <WrapPanel ItemSpacing="10" LineSpacing="6">
        <TextBlock Classes="titulo" Text="Folha mensal" VerticalAlignment="Center" />
        <TextBlock Text="Competência" VerticalAlignment="Center" />
        <c:SeletorCompetencia Competencia="{Binding Competencia}" />
        <Button Content="Calcular folha" Command="{Binding CalcularCommand}" Classes="accent" IsEnabled="{Binding PodeCalcular}" />
        <Button Content="Fechar competência" Command="{Binding FecharCommand}" IsEnabled="{Binding PodeFechar}" />
        <Button Content="Reabrir" Command="{Binding ReabrirCommand}" IsEnabled="{Binding PodeReabrir}" />
        <Rectangle Width="1" Fill="#D0D5DD" Margin="6,4" />
        <Button Content="Recibo do selecionado (PDF)" Command="{Binding ReciboCommand}" IsEnabled="{Binding PodeRelatorios}" />
        <ComboBox Name="FuncionarioHolerite" ItemsSource="{Binding FuncionariosHolerite}" SelectedItem="{Binding FuncionarioHolerite}" MinWidth="220"
                  ToolTip.Tip="Holerite de todos os funcionários da competência ou só de um" />
        <Button Content="Holerites (PDF)" Command="{Binding HoleritesCommand}" IsEnabled="{Binding PodeRelatorios}" />
      </WrapPanel>
      <TextBlock Text="{Binding Situacao}" Foreground="#44506A" />
    </StackPanel>
    <c:MensagensView DockPanel.Dock="Bottom" />
    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Totais}" FontWeight="SemiBold" Margin="0,6,0,0" />
    <Grid RowDefinitions="*,8,*">
      <DataGrid ItemsSource="{Binding Calculos}" SelectedItem="{Binding CalculoSelecionado}" IsReadOnly="True" AutoGenerateColumns="False">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Matrícula" Binding="{ReflectionBinding Matricula}" Width="80" />
          <DataGridTextColumn Header="Funcionário" Binding="{ReflectionBinding Funcionario}" Width="*" />
          <DataGridTextColumn Header="Folha" Binding="{ReflectionBinding Tipo}" Width="170" />
          <DataGridTextColumn Header="Proventos" Binding="{ReflectionBinding Proventos}" Width="110" />
          <DataGridTextColumn Header="Descontos" Binding="{ReflectionBinding Descontos}" Width="110" />
          <DataGridTextColumn Header="Líquido" Binding="{ReflectionBinding Liquido}" Width="110" />
          <DataGridTextColumn Header="INSS" Binding="{ReflectionBinding Inss}" Width="100" />
          <DataGridTextColumn Header="IRRF" Binding="{ReflectionBinding Irrf}" Width="100" />
          <DataGridTextColumn Header="FGTS" Binding="{ReflectionBinding Fgts}" Width="100" />
        </DataGrid.Columns>
      </DataGrid>
      <DockPanel Grid.Row="2">
        <TextBlock DockPanel.Dock="Top" Text="Memória de cálculo do selecionado" FontWeight="SemiBold" Foreground="#1F3A5F" Margin="0,0,0,4" />
        <DataGrid ItemsSource="{Binding Itens}" IsReadOnly="True" AutoGenerateColumns="False">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Cód." Binding="{ReflectionBinding Codigo}" Width="60" />
            <DataGridTextColumn Header="Rubrica" Binding="{ReflectionBinding Descricao}" Width="230" />
            <DataGridTextColumn Header="Ref." Binding="{ReflectionBinding Referencia}" Width="70" />
            <DataGridTextColumn Header="Proventos" Binding="{ReflectionBinding Proventos}" Width="100" />
            <DataGridTextColumn Header="Descontos" Binding="{ReflectionBinding Descontos}" Width="100" />
            <DataGridTextColumn Header="Informativo" Binding="{ReflectionBinding Informativo}" Width="100" />
            <DataGridTextColumn Header="Como foi calculado" Binding="{ReflectionBinding Memoria}" Width="*" />
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </Grid>
  </DockPanel>
</UserControl>
