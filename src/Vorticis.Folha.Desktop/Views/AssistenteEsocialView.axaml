<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Vorticis.Desktop.Comum.Views" xmlns:vm="using:Vorticis.Folha.Desktop.ViewModels"
             x:Class="Vorticis.Folha.Desktop.Views.AssistenteEsocialView" x:DataType="vm:AssistenteEsocialViewModel">
  <!-- Obrigações › eSocial › Assistente de configuração: etapas à esquerda, detalhe e correção à direita -->
  <DockPanel Margin="8">
    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,10">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Classes="titulo" Text="Assistente de configuração do eSocial" VerticalAlignment="Center" />
        <TextBlock Text="Competência" VerticalAlignment="Center" />
        <c:SeletorCompetencia Competencia="{Binding Competencia}" />
        <Button Content="Verificar" Classes="accent" Command="{Binding VerificarCommand}" IsEnabled="{Binding PodeUsar}" />
      </StackPanel>
      <TextBlock Text="{Binding Resumo}" FontWeight="SemiBold" TextWrapping="Wrap" />
    </StackPanel>
    <c:MensagensView DockPanel.Dock="Bottom" />
    <Grid ColumnDefinitions="360,14,*">
      <ListBox Name="ListaEtapas" ItemsSource="{Binding Etapas}" SelectedItem="{Binding Selecionada}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:EtapaEsocialLinha">
            <Grid ColumnDefinitions="30,*,Auto" Margin="0,3">
              <Border Width="22" Height="22" CornerRadius="11" Background="{Binding Cor}" VerticalAlignment="Center">
                <TextBlock Text="{Binding Icone}" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Grid.Column="1" Text="{Binding Titulo}" TextWrapping="Wrap" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="{Binding TextoSituacao}" Foreground="{Binding Cor}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <Border Grid.Column="2" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="6" Padding="16" IsVisible="{Binding TemSelecionada}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
            <Button Content="‹ Etapa anterior" Command="{Binding AnteriorCommand}" />
            <Button Content="Próxima etapa ›" Command="{Binding ProximaCommand}" />
            <Button Content="{Binding TextoCorrigir}" Command="{Binding CorrigirCommand}" IsVisible="{Binding PodeCorrigir}" />
            <Button Content="Gerar todos os eventos" Classes="accent" Command="{Binding GerarEventosCommand}" IsVisible="{Binding EhUltima}" IsEnabled="{Binding PodeUsar}" />
            <Button Content="Abrir Transmissão" Command="{Binding AbrirTransmissaoCommand}" IsVisible="{Binding EhUltima}" />
          </StackPanel>
          <StackPanel Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Border Width="30" Height="30" CornerRadius="15" Background="{Binding Selecionada.Cor, FallbackValue=Gray}">
                <TextBlock Text="{Binding Selecionada.Icone}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="{Binding Selecionada.Titulo}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{Binding Selecionada.E.Explicacao}" TextWrapping="Wrap" Foreground="#334155" />
            <TextBlock Text="O que foi encontrado:" FontWeight="SemiBold" Margin="0,6,0,0" />
            <ScrollViewer MaxHeight="420">
              <ItemsControl Name="PendenciasEtapa" ItemsSource="{Binding Pendencias}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <TextBlock Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" Margin="0,2" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
