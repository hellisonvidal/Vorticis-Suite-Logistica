<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Vorticis.Desktop.Comum.Views"
             xmlns:vm="using:Vorticis.Folha.Desktop.ViewModels"
             x:Class="Vorticis.Folha.Desktop.Views.ProLaboreView"
             x:DataType="vm:ProLaboreViewModel">
  <Grid ColumnDefinitions="*,16,360" RowDefinitions="Auto,*,Auto,200" Margin="8">
    <TextBlock Grid.ColumnSpan="3" Text="{Binding Situacao}" Margin="0,0,0,8" FontWeight="SemiBold" Foreground="#4C1D95" />
    <DockPanel Grid.Row="1">
      <TextBlock DockPanel.Dock="Top" Classes="titulo" Text="Sócios da empresa" Margin="0,0,0,8" />
      <TextBlock DockPanel.Dock="Bottom" FontSize="11" Foreground="Gray" TextWrapping="Wrap" Margin="0,6,0,0"
                 Text="Os sócios vêm de Cadastros › Empresas › aba Sócios (só pessoas físicas). Inclua ou corrija o sócio lá." />
      <DataGrid ItemsSource="{Binding Socios}" SelectedItem="{Binding Selecionado}" IsReadOnly="True" AutoGenerateColumns="False">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Sócio" Binding="{ReflectionBinding Nome}" Width="*" />
          <DataGridTextColumn Header="CPF" Binding="{ReflectionBinding Cpf}" Width="130" />
          <DataGridTextColumn Header="Qualificação" Binding="{ReflectionBinding Qualificacao}" Width="160" />
          <DataGridTextColumn Header="Retira" Binding="{ReflectionBinding Retira}" Width="70" />
          <DataGridTextColumn Header="Valor mensal" Binding="{ReflectionBinding Valor}" Width="120" />
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>
    <StackPanel Grid.Row="1" Grid.Column="2" Spacing="6" IsEnabled="{Binding TemSelecionado}">
      <TextBlock Text="Seu perfil permite apenas consultar." Classes="erro" IsVisible="{Binding !PodeEditar}" />
      <TextBlock Text="Pró-labore do sócio" FontWeight="SemiBold" Foreground="#1F3A5F" />
      <CheckBox Content="Retira pró-labore" IsChecked="{Binding Retira}" IsEnabled="{Binding PodeEditar}" />
      <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6" IsEnabled="{Binding PodeEditar}">
        <TextBlock Classes="rotulo" Text="Valor mensal (R$)" />
        <TextBox Grid.Column="1" Text="{Binding Valor}" IsEnabled="{Binding Retira}" />
        <TextBlock Grid.Row="1" Classes="rotulo" Text="Início" />
        <CalendarDatePicker Grid.Row="1" Grid.Column="1" SelectedDate="{Binding Inicio}" SelectedDateFormat="Custom" CustomDateFormatString="MM/yyyy" />
        <TextBlock Grid.Row="2" Classes="rotulo" Text="Fim (opcional)" />
        <CalendarDatePicker Grid.Row="2" Grid.Column="1" SelectedDate="{Binding Fim}" SelectedDateFormat="Custom" CustomDateFormatString="MM/yyyy" />
        <TextBlock Grid.Row="3" Classes="rotulo" Text="Dependentes (IRRF)" />
        <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding Dependentes}" Minimum="0" Maximum="99" FormatString="0" />
        <TextBlock Grid.Row="4" Classes="rotulo" Text="INSS em outras fontes" ToolTip.Tip="INSS já descontado no mês em outro emprego ou empresa: limita o desconto ao teto." />
        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding InssOutrasFontes}" />
        <TextBlock Grid.Row="5" Classes="rotulo" Text="Observação" />
        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Observacao}" />
      </Grid>
      <Button Content="Gravar" Command="{Binding GravarCommand}" IsEnabled="{Binding PodeEditar}" HorizontalAlignment="Right" />
      <c:MensagensView />
    </StackPanel>
    <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="8" Margin="0,12,0,6">
      <TextBlock Classes="titulo" Text="Cálculo da competência" VerticalAlignment="Center" />
      <Button Content="Calcular pró-labore" Command="{Binding CalcularCommand}" IsEnabled="{Binding PodeCalcular}" />
      <Button Content="Excluir cálculo" Command="{Binding ExcluirCalculoCommand}" IsEnabled="{Binding PodeCalcular}" />
      <TextBlock Text="{Binding Totais}" VerticalAlignment="Center" FontSize="12" />
    </StackPanel>
    <DataGrid Grid.Row="3" Grid.ColumnSpan="3" ItemsSource="{Binding Calculos}" IsReadOnly="True" AutoGenerateColumns="False">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Sócio" Binding="{ReflectionBinding Nome}" Width="200" />
        <DataGridTextColumn Header="Bruto" Binding="{ReflectionBinding Bruto}" Width="110" />
        <DataGridTextColumn Header="INSS (11%)" Binding="{ReflectionBinding Inss}" Width="110" />
        <DataGridTextColumn Header="IRRF" Binding="{ReflectionBinding Irrf}" Width="100" />
        <DataGridTextColumn Header="Líquido" Binding="{ReflectionBinding Liquido}" Width="110" />
        <DataGridTextColumn Header="CPP patronal" Binding="{ReflectionBinding Patronal}" Width="110" />
        <DataGridTextColumn Header="Memória de cálculo" Binding="{ReflectionBinding Memoria}" Width="*" />
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</UserControl>
