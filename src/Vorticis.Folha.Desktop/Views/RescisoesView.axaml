<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Vorticis.Desktop.Comum.Views"
             xmlns:vm="using:Vorticis.Folha.Desktop.ViewModels"
             xmlns:cad="using:Vorticis.Folha.Cadastros"
             x:Class="Vorticis.Folha.Desktop.Views.RescisoesView"
             x:DataType="vm:RescisoesViewModel">
  <Grid ColumnDefinitions="440,16,*" RowDefinitions="Auto,*" Margin="8">
    <TextBlock Grid.ColumnSpan="3" Classes="titulo" Text="Rescisões" Margin="0,0,0,8" />
    <ScrollViewer Grid.Row="1">
      <StackPanel Spacing="6">
        <TextBlock Text="Seu perfil não permite calcular rescisões." Classes="erro" IsVisible="{Binding !PodeCalcular}" />
        <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6" IsEnabled="{Binding PodeCalcular}">
          <TextBlock Classes="rotulo" Text="Funcionário" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding Funcionarios}" SelectedItem="{Binding Funcionario}" HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate><DataTemplate x:DataType="cad:Funcionario"><TextBlock Text="{Binding Nome}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Grid.Row="1" Classes="rotulo" Text="Motivo" />
          <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{x:Static vm:RescisoesViewModel.Motivos}" SelectedItem="{Binding Motivo}" HorizontalAlignment="Stretch" />
          <TextBlock Grid.Row="2" Classes="rotulo" Text="Aviso prévio" />
          <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{x:Static vm:RescisoesViewModel.Avisos}" SelectedItem="{Binding Aviso}" HorizontalAlignment="Stretch" />
          <TextBlock Grid.Row="3" Classes="rotulo" Text="Desligamento" />
          <CalendarDatePicker Grid.Row="3" Grid.Column="1" SelectedDate="{Binding Desligamento}" Width="160" HorizontalAlignment="Left" />
          <TextBlock Grid.Row="4" Classes="rotulo" Text="Pagamento até" />
          <CalendarDatePicker Grid.Row="4" Grid.Column="1" SelectedDate="{Binding Pagamento}" Width="160" HorizontalAlignment="Left" />
          <TextBlock Grid.Row="5" Classes="rotulo" Text="Saldo do FGTS (R$)" />
          <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Spacing="6">
            <TextBox Text="{Binding SaldoFgts}" Width="130" Watermark="Base da multa" />
            <Button Content="Estimar pela folha" Command="{Binding EstimarFgtsCommand}" />
          </StackPanel>
        </Grid>
        <Button Content="Calcular rescisão" Command="{Binding CalcularCommand}" Classes="accent" IsEnabled="{Binding PodeCalcular}" HorizontalAlignment="Left" />
        <TextBlock FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                   Text="Aviso prévio proporcional (Lei 12.506): 30 dias + 3 por ano completo, até 90; no acordo do art. 484-A é pago pela metade. Saldo de salário, férias vencidas e proporcionais (+1/3), 13º proporcional e multa do FGTS (40%; 20% no acordo; 0 nos demais motivos) sobre o saldo informado. Aviso e férias indenizadas não têm INSS nem IRRF. Justa causa: só saldo de salário e férias vencidas. O funcionário passa a Desligado ao calcular." />
        <c:MensagensView />
      </StackPanel>
    </ScrollViewer>
    <DockPanel Grid.Row="1" Grid.Column="2">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
        <TextBlock Text="Rescisões calculadas" FontWeight="SemiBold" Foreground="#1F3A5F" VerticalAlignment="Center" />
        <Button Content="TRCT simplificado (PDF)" Command="{Binding TrctCommand}" />
        <Button Content="Cancelar rescisão" Command="{Binding CancelarCommand}" IsEnabled="{Binding PodeCalcular}" />
      </StackPanel>
      <DataGrid ItemsSource="{Binding Registros}" SelectedItem="{Binding Selecionada}" IsReadOnly="True" AutoGenerateColumns="False">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Funcionário" Binding="{ReflectionBinding Funcionario}" Width="*" />
          <DataGridTextColumn Header="Motivo" Binding="{ReflectionBinding Motivo}" Width="260" />
          <DataGridTextColumn Header="Desligamento" Binding="{ReflectionBinding Desligamento}" Width="100" />
          <DataGridTextColumn Header="Aviso" Binding="{ReflectionBinding Aviso}" Width="140" />
          <DataGridTextColumn Header="Líquido" Binding="{ReflectionBinding Liquido}" Width="100" />
          <DataGridTextColumn Header="Multa FGTS" Binding="{ReflectionBinding Multa}" Width="100" />
          <DataGridTextColumn Header="Situação" Binding="{ReflectionBinding Situacao}" Width="90" />
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>
  </Grid>
</UserControl>
