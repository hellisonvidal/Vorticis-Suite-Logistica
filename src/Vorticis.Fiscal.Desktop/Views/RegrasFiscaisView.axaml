<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Vorticis.Desktop.Comum.Views" xmlns:g="using:Vorticis.Fiscal.Desktop.Views" xmlns:vm="using:Vorticis.Fiscal.Desktop.ViewModels"
             x:Class="Vorticis.Fiscal.Desktop.Views.RegrasFiscaisView" x:DataType="vm:RegrasFiscaisViewModel">
  <Grid ColumnDefinitions="*,12,420" RowDefinitions="Auto,*" Margin="8">
    <TextBlock Grid.ColumnSpan="3" Classes="titulo" Text="Regras fiscais" Margin="0,0,0,6" />
    <DataGrid Grid.Row="1" g:GradesFiscais.Ajustar="True" ItemsSource="{Binding Lista}" SelectedItem="{Binding Selecionada}" IsReadOnly="True" AutoGenerateColumns="False">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Código" Binding="{ReflectionBinding Codigo}" Width="70" />
        <DataGridTextColumn Header="Descrição" Binding="{ReflectionBinding Descricao}" Width="*" />
        <DataGridTextColumn Header="Operação" Binding="{ReflectionBinding Operacao}" Width="80" />
        <DataGridTextColumn Header="CFOP do XML" Binding="{ReflectionBinding CfopOrigem}" Width="190" />
        <DataGridTextColumn Header="CFOP da escrituração" Binding="{ReflectionBinding CfopDestino}" Width="140" />
        <DataGridTextColumn Header="CSTs" Binding="{ReflectionBinding Csts}" Width="160" />
        <DataGridTextColumn Header="Situação" Binding="{ReflectionBinding Situacao}" Width="80" />
      </DataGrid.Columns>
    </DataGrid>
    <ScrollViewer Grid.Row="1" Grid.Column="2">
      <StackPanel Spacing="6">
        <Grid ColumnDefinitions="170,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6" IsEnabled="{Binding PodeManter}">
          <TextBlock Classes="rotulo" Text="Código" />
          <TextBox Grid.Column="1" Text="{Binding Codigo}" Width="90" HorizontalAlignment="Left" />
          <TextBlock Grid.Row="1" Classes="rotulo" Text="Descrição" />
          <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Descricao}" Watermark="Ex.: Compra para comercialização" />
          <TextBlock Grid.Row="2" Classes="rotulo" Text="Operação" />
          <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{x:Static vm:RegrasFiscaisViewModel.Operacoes}" SelectedIndex="{Binding Operacao}" Width="140" />
          <TextBlock Grid.Row="3" Classes="rotulo" Text="{Binding RotuloOrigem}" />
          <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding CfopOrigem}" Width="90" HorizontalAlignment="Left" Watermark="5102" MaxLength="4" />
          <TextBlock Grid.Row="4" Classes="rotulo" Text="{Binding RotuloDestino}" />
          <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding CfopDestino}" Width="90" HorizontalAlignment="Left" Watermark="{Binding ExemploDestino}" MaxLength="4" />
          <TextBlock Grid.Row="5" Classes="rotulo" Text="CST do ICMS (opcional)" />
          <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding CstIcms}" Width="90" HorizontalAlignment="Left" Watermark="00" MaxLength="3" />
          <TextBlock Grid.Row="6" Classes="rotulo" Text="CST do PIS (opcional)" />
          <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding CstPis}" Width="90" HorizontalAlignment="Left" Watermark="50" MaxLength="2" />
          <TextBlock Grid.Row="7" Classes="rotulo" Text="CST da COFINS (opcional)" />
          <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding CstCofins}" Width="90" HorizontalAlignment="Left" Watermark="50" MaxLength="2" />
          <CheckBox Grid.Row="8" Grid.Column="1" Content="Ativa" IsChecked="{Binding Ativa}" />
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="6" IsEnabled="{Binding PodeManter}">
          <Button Content="Nova regra" Command="{Binding NovaCommand}" />
          <Button Content="Gravar" Classes="accent" Command="{Binding GravarCommand}" />
          <Button Content="Excluir" Command="{Binding ExcluirCommand}" />
        </StackPanel>
        <Button Content="Incluir regras sugeridas" Command="{Binding IncluirSugeridasCommand}" IsEnabled="{Binding PodeManter}"
                ToolTip.Tip="Inclui as trocas de entrada mais comuns (5102 → 1102, 6102 → 2102, 5405 → 1403...) que ainda não estão cadastradas" />
        <TextBlock FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                   Text="O CFOP do XML pode ser completo (5102) ou só o começo (51 vale para todos os 51xx); o mais específico vence. A troca é feita sozinha ao importar o XML (de entrada ou de saída, conforme a operação da regra); os CSTs em branco ficam como vieram no XML. Nas notas já importadas, use Aplicar regras fiscais na aba Escrituração." />
        <TextBlock Classes="rotulo" Text="Testar um CFOP do XML" Margin="0,6,0,0" />
        <StackPanel Orientation="Horizontal" Spacing="6">
          <ComboBox ItemsSource="{x:Static vm:RegrasFiscaisViewModel.Operacoes}" SelectedIndex="{Binding OperacaoTeste}" Width="120" />
          <TextBox Text="{Binding Teste}" Width="90" Watermark="{Binding ExemploTeste}" MaxLength="4" />
        </StackPanel>
        <TextBlock Text="{Binding ResultadoTeste}" TextWrapping="Wrap" FontWeight="SemiBold" />
        <c:MensagensView />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
