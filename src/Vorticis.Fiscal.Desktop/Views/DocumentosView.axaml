<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:g="using:Vorticis.Fiscal.Desktop.Views"
             xmlns:c="using:Vorticis.Desktop.Comum.Views"
             xmlns:vm="using:Vorticis.Fiscal.Desktop.ViewModels"
             x:Class="Vorticis.Fiscal.Desktop.Views.DocumentosView"
             x:DataType="vm:DocumentosViewModel">
  <!-- Documentos fiscais › Consulta de documentos -->
  <DockPanel Margin="8">
    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
      <TextBlock Classes="titulo" Text="Consulta de documentos fiscais" />
      <WrapPanel>
        <TextBlock Text="Período" VerticalAlignment="Center" Margin="0,0,6,6" />
        <CalendarDatePicker SelectedDate="{Binding Inicio}" Width="140" Margin="0,0,6,6" />
        <TextBlock Text="a" VerticalAlignment="Center" Margin="0,0,6,6" />
        <CalendarDatePicker SelectedDate="{Binding Fim}" Width="140" Margin="0,0,14,6" />
        <ComboBox ItemsSource="{x:Static vm:DocumentosViewModel.Operacoes}" SelectedIndex="{Binding Operacao}" Width="110" Margin="0,0,8,6" />
        <ComboBox ItemsSource="{x:Static vm:DocumentosViewModel.Modelos}" SelectedIndex="{Binding Modelo}" Width="120" Margin="0,0,8,6" />
        <ComboBox ItemsSource="{x:Static vm:DocumentosViewModel.Situacoes}" SelectedIndex="{Binding Situacao}" Width="120" Margin="0,0,8,6" />
        <ComboBox ItemsSource="{x:Static vm:DocumentosViewModel.Contabilizacoes}" SelectedIndex="{Binding Contabilizacao}" Width="150" Margin="0,0,8,6" />
        <TextBox Text="{Binding Cfop}" Watermark="CFOP" Width="80" Margin="0,0,8,6" />
        <TextBox Text="{Binding Texto}" Watermark="Nº, nome, CNPJ ou chave" Width="210" Margin="0,0,8,6" />
        <Button Content="Consultar" Command="{Binding ConsultarCommand}" Classes="accent" Margin="0,0,8,6" />
        <Button Content="Excluir selecionado" Command="{Binding ExcluirCommand}" IsVisible="{Binding PodeExcluir}" Margin="0,0,8,6" />
      </WrapPanel>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,6,0,0">
      <TextBlock Text="{Binding Resumo}" FontWeight="SemiBold" />
      <c:MensagensView />
    </StackPanel>
    <Grid RowDefinitions="*,6,180">
      <DataGrid g:GradesFiscais.Ajustar="True" ItemsSource="{Binding Documentos}" SelectedItem="{Binding Selecionado}" IsReadOnly="True" AutoGenerateColumns="False">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Data" Binding="{ReflectionBinding Data}" Width="95" />
          <DataGridTextColumn Header="Modelo" Binding="{ReflectionBinding Modelo}" Width="70" />
          <DataGridTextColumn Header="Operação" Binding="{ReflectionBinding Operacao}" Width="80" />
          <DataGridTextColumn Header="Série" Binding="{ReflectionBinding Serie}" Width="55" />
          <DataGridTextColumn Header="Número" Binding="{ReflectionBinding Numero}" Width="90" />
          <DataGridTextColumn Header="Cliente / fornecedor" Binding="{ReflectionBinding Participante}" Width="*" MinWidth="160" />
          <DataGridTextColumn Header="Valor" Binding="{ReflectionBinding Valor}" Width="110" />
          <DataGridTextColumn Header="ICMS" Binding="{ReflectionBinding Icms}" Width="95" />
          <DataGridTextColumn Header="ISS" Binding="{ReflectionBinding Iss}" Width="85" />
          <DataGridTextColumn Header="Situação" Binding="{ReflectionBinding Situacao}" Width="90" />
          <DataGridTextColumn Header="Contab." Binding="{ReflectionBinding Contabilizado}" Width="70" />
          <DataGridTextColumn Header="Chave de acesso" Binding="{ReflectionBinding Chave}" Width="330" />
        </DataGrid.Columns>
      </DataGrid>
      <DataGrid g:GradesFiscais.Ajustar="True" Grid.Row="2" ItemsSource="{Binding Itens}" IsReadOnly="True" AutoGenerateColumns="False">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Item" Binding="{ReflectionBinding N}" Width="50" />
          <DataGridTextColumn Header="CFOP" Binding="{ReflectionBinding Cfop}" Width="65" />
          <DataGridTextColumn Header="NCM" Binding="{ReflectionBinding Ncm}" Width="85" />
          <DataGridTextColumn Header="Descrição" Binding="{ReflectionBinding Descricao}" Width="*" MinWidth="150" />
          <DataGridTextColumn Header="Valor" Binding="{ReflectionBinding Valor}" Width="100" />
          <DataGridTextColumn Header="CST/CSOSN" Binding="{ReflectionBinding CstIcms}" Width="80" />
          <DataGridTextColumn Header="ICMS" Binding="{ReflectionBinding Icms}" Width="85" />
          <DataGridTextColumn Header="ICMS-ST" Binding="{ReflectionBinding IcmsSt}" Width="85" />
          <DataGridTextColumn Header="IPI" Binding="{ReflectionBinding Ipi}" Width="80" />
          <DataGridTextColumn Header="PIS" Binding="{ReflectionBinding Pis}" Width="80" />
          <DataGridTextColumn Header="COFINS" Binding="{ReflectionBinding Cofins}" Width="85" />
          <DataGridTextColumn Header="ISS" Binding="{ReflectionBinding Iss}" Width="80" />
        </DataGrid.Columns>
      </DataGrid>
    </Grid>
  </DockPanel>
</UserControl>
