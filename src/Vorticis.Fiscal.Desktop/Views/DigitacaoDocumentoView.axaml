<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:g="using:Vorticis.Fiscal.Desktop.Views"
             xmlns:c="using:Vorticis.Desktop.Comum.Views"
             xmlns:vm="using:Vorticis.Fiscal.Desktop.ViewModels"
             x:Class="Vorticis.Fiscal.Desktop.Views.DigitacaoDocumentoView"
             x:DataType="vm:DigitacaoDocumentoViewModel">
  <UserControl.Styles>
    <!-- Tela compacta: fonte e espaçamento menores, rótulos acima dos campos -->
    <Style Selector="TextBlock.rot"><Setter Property="FontSize" Value="10.5" /><Setter Property="Foreground" Value="#5A6478" /><Setter Property="Margin" Value="2,0,0,1" /></Style>
    <Style Selector="TextBlock.grupo"><Setter Property="FontSize" Value="11" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="#1F3A5F" /><Setter Property="Margin" Value="0,4,0,0" /></Style>
    <Style Selector="StackPanel.campo"><Setter Property="Margin" Value="0,0,6,0" /></Style>
    <Style Selector="StackPanel.campo TextBox"><Setter Property="MinHeight" Value="26" /><Setter Property="Padding" Value="5,2" /><Setter Property="FontSize" Value="12" /></Style>
    <Style Selector="StackPanel.campo ComboBox"><Setter Property="MinHeight" Value="26" /><Setter Property="Padding" Value="5,2" /><Setter Property="FontSize" Value="12" /></Style>
    <Style Selector="StackPanel.campo CalendarDatePicker"><Setter Property="MinHeight" Value="26" /><Setter Property="FontSize" Value="12" /></Style>
    <Style Selector="Button.mini"><Setter Property="Padding" Value="8,3" /><Setter Property="FontSize" Value="12" /></Style>
    <Style Selector="Expander"><Setter Property="FontSize" Value="12" /></Style>
    <Style Selector="DataGrid"><Setter Property="FontSize" Value="12" /><Setter Property="RowHeight" Value="24" /></Style>
  </UserControl.Styles>
  <!-- Notas fiscais de entrada / saída: consulta das notas lançadas e importadas. "Novo lançamento" e "Abrir" (ou duplo clique / Enter)
       abrem a nota numa janela pop-up (DigitacaoNotaView). -->
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto" Margin="8,4">
    <TextBlock Classes="titulo" Text="{Binding Titulo}" Margin="0,0,0,4" />
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,0,0,4">
      <TextBlock Text="Período" VerticalAlignment="Center" />
      <CalendarDatePicker SelectedDate="{Binding FiltroInicio}" Width="130" />
      <TextBlock Text="a" VerticalAlignment="Center" />
      <CalendarDatePicker SelectedDate="{Binding FiltroFim}" Width="130" />
      <ComboBox ItemsSource="{x:Static vm:DigitacaoDocumentoViewModel.FiltrosModelo}" SelectedIndex="{Binding FiltroModelo}" Width="150" IsVisible="{Binding EscolheModelo}" />
      <TextBox Text="{Binding FiltroTexto}" Width="220" Watermark="Número, chave, nome ou CNPJ" />
      <Button Classes="mini" Content="Consultar" Command="{Binding ConsultarCommand}" />
      <Button Classes="mini accent" Content="Novo lançamento" Command="{Binding NovoLancamentoCommand}" IsEnabled="{Binding PodeManter}" />
      <Button Classes="mini" Content="Abrir" Command="{Binding AbrirCommand}" ToolTip.Tip="Abre a nota selecionada (também com duplo clique ou Enter)" />
      <Button Classes="mini" Content="Excluir" Command="{Binding ExcluirCommand}" IsEnabled="{Binding PodeManter}"
              ToolTip.Tip="Exclui a nota selecionada, lançada ou importada (contabilizada: desfaz a contabilização antes, com confirmação)" />
      <Button Classes="mini" Content="Importar XML ▾" IsEnabled="{Binding Importador.PodeIniciar}"
              ToolTip.Tip="Importa NF-e, NFC-e e NFS-e (arquivo, vários arquivos, pasta com subpastas ou .zip); as notas aparecem na lista abaixo">
        <Button.Flyout>
          <MenuFlyout>
            <MenuItem Header="Arquivo(s) XML ou .zip..." Click="ImportarArquivos" />
            <MenuItem Header="Pasta (inclui as subpastas)..." Click="ImportarPasta" />
          </MenuFlyout>
        </Button.Flyout>
      </Button>
    </StackPanel>
    <!-- Importação individual pela chave de acesso (SEFAZ / Ambiente Nacional, com o certificado da empresa) -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" IsEnabled="{Binding PodeManter}" Margin="0,0,0,4">
      <TextBox Text="{Binding ChaveImportacao}" Width="380" Watermark="Chave de acesso da NF-e (44 dígitos)" MaxLength="60" />
      <Button Classes="mini" Content="Importar pela chave" Command="{Binding ImportarChaveCommand}"
              ToolTip.Tip="Baixa o XML da NF-e na SEFAZ (Ambiente Nacional, como no Portal da NF-e) com o certificado digital da empresa e importa a nota" />
      <Button Classes="mini" Content="Manifestar ciência" Command="{Binding ManifestarCienciaCommand}" IsVisible="{Binding PodeManifestar}"
              ToolTip.Tip="Registra a Ciência da operação (manifestação do destinatário), que libera o XML completo" />
    </StackPanel>
    <g:PainelImportacaoView Grid.Row="3" DataContext="{Binding Importador}" />
    <c:MensagensView Grid.Row="4" DataContext="{Binding Importador}" />
    <DataGrid x:Name="ListaNotas" Grid.Row="5" g:GradesFiscais.Ajustar="True" ItemsSource="{Binding Lista}" SelectedItem="{Binding Selecionada}" IsReadOnly="True"
              AutoGenerateColumns="False" DoubleTapped="AoDuploClique" KeyDown="AoTeclarLista">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Data" Binding="{ReflectionBinding Data}" Width="95" />
        <DataGridTextColumn Header="Modelo" Binding="{ReflectionBinding Modelo}" Width="75" />
        <DataGridTextColumn Header="Série" Binding="{ReflectionBinding Serie}" Width="60" />
        <DataGridTextColumn Header="Número" Binding="{ReflectionBinding Numero}" Width="90" />
        <DataGridTextColumn Header="Cliente / fornecedor" Binding="{ReflectionBinding Participante}" Width="*" MinWidth="170" />
        <DataGridTextColumn Header="Valor" Binding="{ReflectionBinding Valor}" Width="105" />
        <DataGridTextColumn Header="Origem" Binding="{ReflectionBinding Origem}" Width="80" />
        <DataGridTextColumn Header="Contab." Binding="{ReflectionBinding Contabilizado}" Width="75" />
      </DataGrid.Columns>
    </DataGrid>
    <StackPanel Grid.Row="6" Spacing="2">
      <TextBlock Text="{Binding ResumoLista}" FontWeight="SemiBold" Margin="0,4,0,0" />
      <c:MensagensView IsVisible="{Binding !DigitacaoAberta}" />
    </StackPanel>
  </Grid>
</UserControl>
