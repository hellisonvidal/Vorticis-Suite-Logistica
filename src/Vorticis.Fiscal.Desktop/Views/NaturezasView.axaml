<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Vorticis.Desktop.Comum.Views" xmlns:g="using:Vorticis.Fiscal.Desktop.Views" xmlns:vm="using:Vorticis.Fiscal.Desktop.ViewModels"
             x:Class="Vorticis.Fiscal.Desktop.Views.NaturezasView" x:DataType="vm:NaturezasViewModel">
  <Grid ColumnDefinitions="*,12,400" RowDefinitions="Auto,*" Margin="8">
    <TextBlock Grid.ColumnSpan="3" Classes="titulo" Text="Naturezas de entrada" Margin="0,0,0,6" />
    <DataGrid Grid.Row="1" g:GradesFiscais.Ajustar="True" ItemsSource="{Binding Lista}" SelectedItem="{Binding Selecionada}" IsReadOnly="True" AutoGenerateColumns="False">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Código" Binding="{ReflectionBinding Codigo}" Width="70" />
        <DataGridTextColumn Header="Descrição" Binding="{ReflectionBinding Descricao}" Width="*" />
        <DataGridTextColumn Header="CFOP de saída (XML)" Binding="{ReflectionBinding CfopSaida}" Width="200" />
        <DataGridTextColumn Header="CFOP de entrada" Binding="{ReflectionBinding CfopEntrada}" Width="120" />
        <DataGridTextColumn Header="Situação" Binding="{ReflectionBinding Situacao}" Width="80" />
      </DataGrid.Columns>
    </DataGrid>
    <ScrollViewer Grid.Row="1" Grid.Column="2">
      <StackPanel Spacing="6">
        <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="6" IsEnabled="{Binding PodeManter}">
          <TextBlock Classes="rotulo" Text="Código" />
          <TextBox Grid.Column="1" Text="{Binding Codigo}" Width="90" HorizontalAlignment="Left" />
          <TextBlock Grid.Row="1" Classes="rotulo" Text="Descrição" />
          <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Descricao}" Watermark="Ex.: Compra para comercialização" />
          <TextBlock Grid.Row="2" Classes="rotulo" Text="CFOP de saída (XML)" />
          <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CfopSaida}" Width="90" HorizontalAlignment="Left" Watermark="5102" MaxLength="4" />
          <TextBlock Grid.Row="3" Classes="rotulo" Text="CFOP de entrada" />
          <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding CfopEntrada}" Width="90" HorizontalAlignment="Left" Watermark="1102" MaxLength="4" />
          <CheckBox Grid.Row="4" Grid.Column="1" Content="Ativa" IsChecked="{Binding Ativa}" />
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="6" IsEnabled="{Binding PodeManter}">
          <Button Content="Nova natureza" Command="{Binding NovaCommand}" />
          <Button Content="Gravar" Classes="accent" Command="{Binding GravarCommand}" />
          <Button Content="Excluir" Command="{Binding ExcluirCommand}" />
        </StackPanel>
        <Button Content="Incluir naturezas sugeridas" Command="{Binding IncluirSugeridasCommand}" IsEnabled="{Binding PodeManter}"
                ToolTip.Tip="Inclui as trocas mais comuns (5102 → 1102, 6102 → 2102, 5405 → 1403...) que ainda não estão cadastradas" />
        <TextBlock FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                   Text="O CFOP de saída pode ser completo (5102) ou só o começo (51 vale para todos os 51xx); o mais específico vence. A troca é feita sozinha ao importar o XML de uma nota de entrada; nas notas já importadas, use Aplicar naturezas na aba Escrituração." />
        <TextBlock Classes="rotulo" Text="Testar um CFOP de saída" Margin="0,6,0,0" />
        <TextBox Text="{Binding Teste}" Width="90" HorizontalAlignment="Left" Watermark="5102" MaxLength="4" />
        <TextBlock Text="{Binding ResultadoTeste}" TextWrapping="Wrap" FontWeight="SemiBold" />
        <c:MensagensView />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
