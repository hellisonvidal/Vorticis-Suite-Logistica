<Project Sdk="Microsoft.NET.Sdk">
  <!-- Executável do módulo Fiscal: usa o casco comum (login, empresas, usuários, backup...) e acrescenta as telas do módulo. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AssemblyName>VorticisFiscal</AssemblyName>
    <Product>Vorticis Fiscal</Product>
    <Title>Vorticis Fiscal</Title>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Ícone do módulo (gerado por instalador/icone/gerar_icone.py) -->
    <ApplicationIcon>..\..\instalador\icone\VorticisFiscal.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Vorticis.Desktop.Comum\Vorticis.Desktop.Comum.csproj" />
    <ProjectReference Include="..\Vorticis.Fiscal\Vorticis.Fiscal.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Vorticis.Desktop.Comum" />
    <Using Include="Vorticis.Desktop.Comum.ViewModels" />
    <Using Include="Vorticis.Desktop.Comum.Views" />
    <Using Include="Vorticis.Infra" />
    <Using Include="Vorticis.Fiscal" />
  </ItemGroup>
</Project>
