<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Vorticis.Desktop.Comum.Views" xmlns:vm="using:Vorticis.Erp.Desktop.ViewModels"
             x:Class="Vorticis.Erp.Desktop.Views.PainelView" x:DataType="vm:PainelViewModel">
  <DockPanel Margin="8">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
      <TextBlock Classes="titulo" Text="Painel do empresário" VerticalAlignment="Center" />
      <TextBlock Text="Mês de referência" VerticalAlignment="Center" />
      <CalendarDatePicker SelectedDate="{Binding Referencia}" Width="140" />
      <TextBlock Text="{Binding Resumo}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#134E4A" />
    </StackPanel>
    <c:MensagensView DockPanel.Dock="Bottom" />
    <Grid ColumnDefinitions="*,12,*" RowDefinitions="*,12,*">
      <DataGrid Grid.RowSpan="3" ItemsSource="{Binding Indicadores}" IsReadOnly="True" AutoGenerateColumns="False">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Indicador" Binding="{ReflectionBinding Descricao}" Width="*" />
          <DataGridTextColumn Header="Valor" Binding="{ReflectionBinding Valor}" Width="160" />
        </DataGrid.Columns>
      </DataGrid>
      <DockPanel Grid.Column="2">
        <TextBlock DockPanel.Dock="Top" Text="Maiores clientes do mês" FontWeight="SemiBold" Margin="0,0,0,4" />
        <DataGrid ItemsSource="{Binding Clientes}" IsReadOnly="True" AutoGenerateColumns="False">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Cliente" Binding="{ReflectionBinding Descricao}" Width="*" />
            <DataGridTextColumn Header="Vendas" Binding="{ReflectionBinding Valor}" Width="140" />
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
      <Grid Grid.Column="2" Grid.Row="2" ColumnDefinitions="*,8,*">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Produtos mais vendidos" FontWeight="SemiBold" Margin="0,0,0,4" />
          <DataGrid ItemsSource="{Binding Produtos}" IsReadOnly="True" AutoGenerateColumns="False">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Produto (qtde)" Binding="{ReflectionBinding Descricao}" Width="*" />
              <DataGridTextColumn Header="Valor" Binding="{ReflectionBinding Valor}" Width="110" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
        <DockPanel Grid.Column="2">
          <TextBlock DockPanel.Dock="Top" Text="Fluxo previsto (próximas 8 semanas)" FontWeight="SemiBold" Margin="0,0,0,4" />
          <DataGrid ItemsSource="{Binding Fluxo}" IsReadOnly="True" AutoGenerateColumns="False">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Semana" Binding="{ReflectionBinding Descricao}" Width="120" />
              <DataGridTextColumn Header="Receber − pagar" Binding="{ReflectionBinding Valor}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Grid>
    </Grid>
  </DockPanel>
</UserControl>
