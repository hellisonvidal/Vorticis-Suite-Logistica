<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Vorticis.Frota.Desktop.App"
             xmlns:c="using:Vorticis.Desktop.Comum.Views"
             xmlns:vm="using:Vorticis.Frota.Desktop.ViewModels"
             xmlns:v="using:Vorticis.Frota.Desktop.Views"
             RequestedThemeVariant="Light">
  <Application.DataTemplates>
    <c:TemplatesComuns />
    <DataTemplate DataType="vm:PainelFrotaViewModel"><v:PainelFrotaView /></DataTemplate>
    <DataTemplate DataType="vm:VeiculosViewModel"><v:VeiculosView /></DataTemplate>
    <DataTemplate DataType="vm:MotoristasViewModel"><v:MotoristasView /></DataTemplate>
    <DataTemplate DataType="vm:PlanosViewModel"><v:PlanosView /></DataTemplate>
    <DataTemplate DataType="vm:DocumentosViewModel"><v:DocumentosView /></DataTemplate>
    <DataTemplate DataType="vm:MultasViewModel"><v:MultasView /></DataTemplate>
    <DataTemplate DataType="vm:ContratosViewModel"><v:ContratosView /></DataTemplate>
    <DataTemplate DataType="vm:BensContratosViewModel"><v:BensContratosView /></DataTemplate>
    <DataTemplate DataType="vm:CiotViewModel"><v:CiotView /></DataTemplate>
    <DataTemplate DataType="vm:AbastecimentosViewModel"><v:AbastecimentosView /></DataTemplate>
    <DataTemplate DataType="vm:OrdensViewModel"><v:OrdensView /></DataTemplate>
    <DataTemplate DataType="vm:ItensManutencaoViewModel"><v:ItensManutencaoView /></DataTemplate>
    <DataTemplate DataType="vm:AutorizacaoViewModel"><v:AutorizacaoView /></DataTemplate>
    <DataTemplate DataType="vm:NotasCompraViewModel"><v:NotasCompraView /></DataTemplate>
    <DataTemplate DataType="vm:ViagensViewModel"><v:ViagensView /></DataTemplate>
    <DataTemplate DataType="vm:RelatorioFrotaViewModel"><v:RelatorioFrotaView /></DataTemplate>
    <DataTemplate DataType="vm:FrotasViewModel"><v:FrotasView /></DataTemplate>
    <DataTemplate DataType="vm:RotasViewModel"><v:RotasView /></DataTemplate>
    <DataTemplate DataType="vm:DiariasViewModel"><v:DiariasView /></DataTemplate>
    <DataTemplate DataType="vm:PedagioViewModel"><v:PedagioView /></DataTemplate>
    <DataTemplate DataType="vm:LayoutsPedagioViewModel"><v:LayoutsPedagioView /></DataTemplate>
    <DataTemplate DataType="vm:ColetasViewModel"><v:ColetasView /></DataTemplate>
    <DataTemplate DataType="vm:TabelasFreteViewModel"><v:TabelasFreteView /></DataTemplate>
    <DataTemplate DataType="vm:CotacoesViewModel"><v:CotacoesView /></DataTemplate>
    <DataTemplate DataType="vm:CtesViewModel"><v:CtesView /></DataTemplate>
    <DataTemplate DataType="vm:ManifestosViewModel"><v:ManifestosView /></DataTemplate>
    <DataTemplate DataType="vm:EntregasViewModel"><v:EntregasView /></DataTemplate>
    <DataTemplate DataType="vm:FaturasFreteViewModel"><v:FaturasFreteView /></DataTemplate>
  </Application.DataTemplates>
  <Application.Styles>
    <StyleInclude Source="avares://Vorticis.Desktop.Comum/Estilos.axaml" />
    <Style Selector="TextBlock.rotulo">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="DataGridCell.numerica">
      <Setter Property="HorizontalContentAlignment" Value="Right" />
    </Style>
  </Application.Styles>
</Application>
