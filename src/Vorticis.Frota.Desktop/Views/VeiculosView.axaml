<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Vorticis.Desktop.Comum.Views" xmlns:vm="using:Vorticis.Frota.Desktop.ViewModels"
             x:Class="Vorticis.Frota.Desktop.Views.VeiculosView" x:DataType="vm:VeiculosViewModel">
  <Grid ColumnDefinitions="*,12,400" RowDefinitions="Auto,*" Margin="8">
    <StackPanel Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
      <TextBlock Classes="titulo" Text="Veículos" VerticalAlignment="Center" />
      <TextBlock Text="{Binding Totais}" VerticalAlignment="Center" FontSize="12" />
    </StackPanel>
    <DataGrid Grid.Row="1" ItemsSource="{Binding Lista}" SelectedItem="{Binding Selecionado}" IsReadOnly="True" AutoGenerateColumns="False">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Código" Binding="{ReflectionBinding Codigo}" Width="70" />
        <DataGridTextColumn Header="Placa" Binding="{ReflectionBinding Placa}" Width="95" />
        <DataGridTextColumn Header="Tipo" Binding="{ReflectionBinding Tipo}" Width="110" />
        <DataGridTextColumn Header="Marca / modelo" Binding="{ReflectionBinding MarcaModelo}" Width="*" />
        <DataGridTextColumn Header="Ano" Binding="{ReflectionBinding Ano}" Width="90" />
        <DataGridTextColumn Header="Combustível" Binding="{ReflectionBinding Combustivel}" Width="110" />
        <DataGridTextColumn Header="Km atual" Binding="{ReflectionBinding Km}" Width="90" />
        <DataGridTextColumn Header="Situação" Binding="{ReflectionBinding Situacao}" Width="75" />
      </DataGrid.Columns>
    </DataGrid>
    <ScrollViewer Grid.Row="1" Grid.Column="2">
    <StackPanel Spacing="6" IsEnabled="{Binding PodeEditar}">
      <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
        <TextBlock Classes="rotulo" Text="Código" />
        <TextBox Grid.Column="1" Text="{Binding Codigo}" Width="90" HorizontalAlignment="Left" />
        <TextBlock Grid.Row="1" Classes="rotulo" Text="Placa" />
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Placa}" Watermark="ABC1D23 ou ABC-1234" Width="140" HorizontalAlignment="Left" />
        <TextBlock Grid.Row="2" Classes="rotulo" Text="RENAVAM" />
        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Renavam}" Watermark="11 dígitos" />
        <TextBlock Grid.Row="3" Classes="rotulo" Text="Tipo" />
        <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{x:Static vm:VeiculosViewModel.Tipos}" SelectedItem="{Binding Tipo}" Width="180" />
        <TextBlock Grid.Row="4" Classes="rotulo" Text="Marca / modelo" />
        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="6">
          <TextBox Text="{Binding Marca}" Width="110" Watermark="Marca" />
          <TextBox Text="{Binding Modelo}" Width="140" Watermark="Modelo" />
        </StackPanel>
        <TextBlock Grid.Row="5" Classes="rotulo" Text="Ano fabricação / modelo" />
        <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Spacing="6">
          <TextBox Text="{Binding AnoFabricacao}" Width="80" />
          <TextBox Text="{Binding AnoModelo}" Width="80" />
        </StackPanel>
        <TextBlock Grid.Row="6" Classes="rotulo" Text="Combustível" />
        <ComboBox Grid.Row="6" Grid.Column="1" ItemsSource="{x:Static vm:VeiculosViewModel.Combustiveis}" SelectedItem="{Binding Combustivel}" Width="180" />
        <TextBlock Grid.Row="7" Classes="rotulo" Text="Capacidade (kg)" />
        <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding Capacidade}" Width="140" HorizontalAlignment="Left" />
        <TextBlock Grid.Row="8" Classes="rotulo" Text="Km atual" />
        <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding KmAtual}" Width="140" HorizontalAlignment="Left" />
        <TextBlock Grid.Row="9" Classes="rotulo" Text="Média esperada (km/l)" />
        <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding MediaEsperada}" Width="140" HorizontalAlignment="Left" Watermark="Ex.: 2,5" />
        <TextBlock Grid.Row="10" Classes="rotulo" Text="Observação" />
        <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding Observacao}" />
        <TextBlock Grid.Row="11" Classes="rotulo" Text="Frota" />
        <ComboBox Grid.Row="11" Grid.Column="1" ItemsSource="{Binding FrotasOpcoes}" SelectedItem="{Binding Frota}" HorizontalAlignment="Stretch" />
        <CheckBox Grid.Row="12" Grid.Column="1" Content="Veículo ativo" IsChecked="{Binding Ativo}" />
      </Grid>
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Button Content="Novo veículo" Command="{Binding NovoCommand}" />
        <Button Content="Gravar" Classes="accent" Command="{Binding GravarCommand}" />
        <Button Content="Excluir" Command="{Binding ExcluirCommand}" />
      </StackPanel>
      <TextBlock FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                 Text="O km atual é atualizado sozinho pelos abastecimentos, ordens de serviço e viagens. Reboques e semirreboques não abastecem." />
      <c:MensagensView />
    </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
