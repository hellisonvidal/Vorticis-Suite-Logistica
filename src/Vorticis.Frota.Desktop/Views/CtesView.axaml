<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Vorticis.Desktop.Comum.Views" xmlns:vm="using:Vorticis.Frota.Desktop.ViewModels"
             x:Class="Vorticis.Frota.Desktop.Views.CtesView" x:DataType="vm:CtesViewModel">
  <UserControl.Styles>
    <Style Selector="Border.cartao">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
  </UserControl.Styles>
  <!-- Conhecimentos de transporte: a lista dos CT-e com filtros e o painel dos valores; Novo CT-e e Abrir (duplo clique ou Enter) editam numa janela pop-up. -->
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="8">
    <TextBlock Classes="titulo" Text="Conhecimentos de transporte (CT-e)" Margin="0,0,0,6" />
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
      <TextBlock Text="Período" VerticalAlignment="Center" />
      <CalendarDatePicker SelectedDate="{Binding Inicio}" Width="130" />
      <TextBlock Text="a" VerticalAlignment="Center" />
      <CalendarDatePicker SelectedDate="{Binding Fim}" Width="130" />
      <TextBlock Text="Situação" VerticalAlignment="Center" />
      <ComboBox ItemsSource="{x:Static vm:CtesViewModel.FiltroSituacoes}" SelectedItem="{Binding FiltroSituacao}" Width="150" />
      <TextBox Text="{Binding FiltroTexto}" Width="280" Watermark="Número, chave, cliente, placa, cidade ou NF-e" />
    </StackPanel>
    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,6">
      <Border Classes="cartao"><StackPanel><TextBlock Text="CT-e listados" FontSize="11" /><TextBlock Text="{Binding PainelQuantidadeCtes}" FontSize="18" FontWeight="Bold" /></StackPanel></Border>
      <Border Classes="cartao"><StackPanel><TextBlock Text="Frete (total da prestação)" FontSize="11" /><TextBlock Text="{Binding PainelFreteCtes}" FontSize="18" FontWeight="Bold" /></StackPanel></Border>
      <Border Classes="cartao"><StackPanel><TextBlock Text="ICMS" FontSize="11" /><TextBlock Text="{Binding PainelIcms}" FontSize="18" FontWeight="Bold" /></StackPanel></Border>
      <Border Classes="cartao"><StackPanel><TextBlock Text="Peso transportado" FontSize="11" /><TextBlock Text="{Binding PainelPesoCtes}" FontSize="18" FontWeight="Bold" /></StackPanel></Border>
      <Border Classes="cartao"><StackPanel><TextBlock Text="Valor das mercadorias" FontSize="11" /><TextBlock Text="{Binding PainelMercadoria}" FontSize="18" FontWeight="Bold" /></StackPanel></Border>
    </StackPanel>
    <StackPanel Grid.Row="3" Spacing="6" Margin="0,0,0,6">
      <TextBlock Text="{Binding Totais}" FontSize="12" />
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Button Content="Novo CT-e" Classes="accent" Command="{Binding NovoCteCommand}" IsEnabled="{Binding PodeEditar}" />
        <Button Content="Abrir" Command="{Binding AbrirCommand}" ToolTip.Tip="Abre o CT-e selecionado (também com duplo clique ou Enter)" />
        <Button Content="Imprimir minuta (PDF)" Command="{Binding ImprimirCommand}" />
        <Button Content="Excluir" Command="{Binding ExcluirCommand}" IsEnabled="{Binding PodeEditar}" />
      </StackPanel>
    </StackPanel>
    <DataGrid Name="ListaCtes" Grid.Row="4" ItemsSource="{Binding Lista}" SelectedItem="{Binding Selecionado}" IsReadOnly="True" AutoGenerateColumns="False"
              DoubleTapped="AoDuploClique" KeyDown="AoTeclar">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Nº" Binding="{ReflectionBinding Numero}" Width="70" />
        <DataGridTextColumn Header="Emissão" Binding="{ReflectionBinding Emissao}" Width="90" />
        <DataGridTextColumn Header="Tomador" Binding="{ReflectionBinding Tomador}" Width="170" />
        <DataGridTextColumn Header="Destinatário" Binding="{ReflectionBinding Destinatario}" Width="170" />
        <DataGridTextColumn Header="Trecho" Binding="{ReflectionBinding Trecho}" Width="*" MinWidth="180" />
        <DataGridTextColumn Header="Peso (kg)" Binding="{ReflectionBinding Peso}" Width="85" />
        <DataGridTextColumn Header="Valor" Binding="{ReflectionBinding Valor}" Width="110" />
        <DataGridTextColumn Header="Previsão" Binding="{ReflectionBinding Previsao}" Width="90" />
        <DataGridTextColumn Header="Prazo" Binding="{ReflectionBinding Prazo}" Width="120" />
        <DataGridTextColumn Header="Situação" Binding="{ReflectionBinding Situacao}" Width="100" />
        <DataGridTextColumn Header="Fatura" Binding="{ReflectionBinding Fatura}" Width="65" />
      </DataGrid.Columns>
    </DataGrid>
    <c:MensagensView Grid.Row="5" IsVisible="{Binding !EdicaoAberta}" />
  </Grid>
</UserControl>
