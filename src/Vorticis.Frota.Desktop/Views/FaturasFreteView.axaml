<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Vorticis.Desktop.Comum.Views" xmlns:vm="using:Vorticis.Frota.Desktop.ViewModels"
             x:Class="Vorticis.Frota.Desktop.Views.FaturasFreteView" x:DataType="vm:FaturasFreteViewModel">
  <Grid ColumnDefinitions="*,12,430" RowDefinitions="Auto,Auto,*" Margin="8">
    <StackPanel Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
      <TextBlock Classes="titulo" Text="Faturas de frete" VerticalAlignment="Center" />
      <TextBlock Text="Período" VerticalAlignment="Center" />
      <CalendarDatePicker SelectedDate="{Binding Inicio}" Width="130" />
      <TextBlock Text="a" VerticalAlignment="Center" />
      <CalendarDatePicker SelectedDate="{Binding Fim}" Width="130" />
    </StackPanel>
    <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding Totais}" FontSize="12" Margin="0,0,0,6" />
    <DataGrid Grid.Row="2" ItemsSource="{Binding Lista}" SelectedItem="{Binding Selecionada}" IsReadOnly="True" AutoGenerateColumns="False">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Nº" Binding="{ReflectionBinding Numero}" Width="55" />
        <DataGridTextColumn Header="Emissão" Binding="{ReflectionBinding Emissao}" Width="85" />
        <DataGridTextColumn Header="Vencimento" Binding="{ReflectionBinding Vencimento}" Width="90" />
        <DataGridTextColumn Header="Cliente" Binding="{ReflectionBinding Cliente}" Width="*" />
        <DataGridTextColumn Header="CT-e" Binding="{ReflectionBinding Ctes}" Width="55" />
        <DataGridTextColumn Header="Valor" Binding="{ReflectionBinding Valor}" Width="95" />
        <DataGridTextColumn Header="Saldo" Binding="{ReflectionBinding Saldo}" Width="95" />
        <DataGridTextColumn Header="Situação" Binding="{ReflectionBinding Situacao}" Width="90" />
      </DataGrid.Columns>
    </DataGrid>
    <ScrollViewer Grid.Row="2" Grid.Column="2">
    <StackPanel Spacing="6" IsEnabled="{Binding PodeEditar}">
      <TextBlock Text="Nova fatura" FontWeight="Bold" FontSize="12" />
      <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">
        <TextBlock Classes="rotulo" Text="Cliente (tomador)" />
        <ComboBox Grid.Column="1" ItemsSource="{Binding ParticipantesOpcoes}" SelectedItem="{Binding Cliente}" HorizontalAlignment="Stretch" />
        <TextBlock Grid.Row="1" Classes="rotulo" Text="Emissão" />
        <CalendarDatePicker Grid.Row="1" Grid.Column="1" SelectedDate="{Binding Emissao}" Width="140" HorizontalAlignment="Left" />
        <TextBlock Grid.Row="2" Classes="rotulo" Text="Vencimento" />
        <CalendarDatePicker Grid.Row="2" Grid.Column="1" SelectedDate="{Binding Vencimento}" Width="140" HorizontalAlignment="Left" />
        <TextBlock Grid.Row="3" Classes="rotulo" Text="Observação" />
        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Observacao}" />
      </Grid>
      <TextBlock Classes="rotulo" Text="CT-e emitidos sem fatura" />
      <Border BorderBrush="LightGray" BorderThickness="1" Padding="4">
        <ScrollViewer MaxHeight="220">
          <ItemsControl ItemsSource="{Binding Ctes}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CteMarcado">
                <CheckBox IsChecked="{Binding Marcado}" Content="{Binding Texto}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>
      <TextBlock Text="{Binding TotalMarcado}" FontWeight="Bold" />
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Button Content="Gerar fatura" Classes="accent" Command="{Binding GerarCommand}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Button Content="Imprimir fatura (PDF)" Command="{Binding ImprimirCommand}" />
        <Button Content="Cancelar fatura" Command="{Binding CancelarCommand}" />
      </StackPanel>
      <TextBlock FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                 Text="A fatura gera a conta a receber do cliente em Financeiro › Contas a receber. Só a fatura sem recebimento pode ser cancelada." />
      <c:MensagensView />
    </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
