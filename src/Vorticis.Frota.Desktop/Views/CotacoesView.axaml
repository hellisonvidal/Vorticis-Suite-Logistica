<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Vorticis.Desktop.Comum.Views" xmlns:vm="using:Vorticis.Frota.Desktop.ViewModels"
             x:Class="Vorticis.Frota.Desktop.Views.CotacoesView" x:DataType="vm:CotacoesViewModel">
  <Grid ColumnDefinitions="*,12,430" RowDefinitions="Auto,Auto,*" Margin="8">
    <StackPanel Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
      <TextBlock Classes="titulo" Text="Cotações de frete" VerticalAlignment="Center" />
      <TextBlock Text="Período" VerticalAlignment="Center" />
      <CalendarDatePicker SelectedDate="{Binding Inicio}" Width="130" />
      <TextBlock Text="a" VerticalAlignment="Center" />
      <CalendarDatePicker SelectedDate="{Binding Fim}" Width="130" />
      <TextBlock Text="Situação" VerticalAlignment="Center" />
      <ComboBox ItemsSource="{x:Static vm:CotacoesViewModel.FiltroSituacoes}" SelectedItem="{Binding FiltroSituacao}" Width="150" />
    </StackPanel>
    <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding Totais}" FontSize="12" Margin="0,0,0,6" />
    <DataGrid Grid.Row="2" ItemsSource="{Binding Lista}" SelectedItem="{Binding Selecionada}" IsReadOnly="True" AutoGenerateColumns="False">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Nº" Binding="{ReflectionBinding Numero}" Width="55" />
        <DataGridTextColumn Header="Data" Binding="{ReflectionBinding Data}" Width="85" />
        <DataGridTextColumn Header="Validade" Binding="{ReflectionBinding Validade}" Width="85" />
        <DataGridTextColumn Header="Cliente" Binding="{ReflectionBinding Cliente}" Width="*" />
        <DataGridTextColumn Header="Trecho" Binding="{ReflectionBinding Trecho}" Width="170" />
        <DataGridTextColumn Header="Peso (kg)" Binding="{ReflectionBinding Peso}" Width="80" />
        <DataGridTextColumn Header="Valor" Binding="{ReflectionBinding Valor}" Width="95" />
        <DataGridTextColumn Header="Situação" Binding="{ReflectionBinding Situacao}" Width="90" />
      </DataGrid.Columns>
    </DataGrid>
    <ScrollViewer Grid.Row="2" Grid.Column="2">
    <StackPanel Spacing="6" IsEnabled="{Binding PodeEditar}">
      <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
        <TextBlock Classes="rotulo" Text="Data" />
        <CalendarDatePicker Grid.Column="1" SelectedDate="{Binding Data}" Width="140" HorizontalAlignment="Left" />
        <TextBlock Grid.Row="1" Classes="rotulo" Text="Validade" />
        <CalendarDatePicker Grid.Row="1" Grid.Column="1" SelectedDate="{Binding Validade}" Width="140" HorizontalAlignment="Left" />
        <TextBlock Grid.Row="2" Classes="rotulo" Text="Cliente" />
        <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding ParticipantesOpcoes}" SelectedItem="{Binding Cliente}" HorizontalAlignment="Stretch" />
        <TextBlock Grid.Row="3" Classes="rotulo" Text="Tabela de frete" />
        <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding TabelasOpcoes}" SelectedItem="{Binding Tabela}" HorizontalAlignment="Stretch" />
        <TextBlock Grid.Row="4" Classes="rotulo" Text="Origem" />
        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Origem}" />
        <TextBlock Grid.Row="5" Classes="rotulo" Text="Destino" />
        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Destino}" />
        <TextBlock Grid.Row="6" Classes="rotulo" Text="Peso (kg) / m³" />
        <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Spacing="6"><TextBox Text="{Binding Peso}" Width="130" Watermark="Peso (kg)" /><TextBox Text="{Binding VolumeM3}" Width="100" Watermark="m³" /></StackPanel>
        <TextBlock Grid.Row="7" Classes="rotulo" Text="Valor da mercadoria" />
        <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding ValorMercadoria}" Width="140" HorizontalAlignment="Left" />
        <TextBlock Grid.Row="8" Classes="rotulo" Text="" />
        <CheckBox Grid.Row="8" Grid.Column="1" IsChecked="{Binding Coleta}" Content="Cobrar coleta" />
        <TextBlock Grid.Row="9" Classes="rotulo" Text="" />
        <CheckBox Grid.Row="9" Grid.Column="1" IsChecked="{Binding Entrega}" Content="Cobrar entrega" />
        <TextBlock Grid.Row="10" Classes="rotulo" Text="Observação" />
        <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding Observacao}" />
        <TextBlock Grid.Row="11" Classes="rotulo" Text="Cálculo" />
        <TextBlock Grid.Row="11" Grid.Column="1" Text="{Binding Calculo}" TextWrapping="Wrap" FontWeight="Bold" />
      </Grid>
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Button Content="Nova cotação" Command="{Binding NovaCommand}" />
        <Button Content="Gravar" Classes="accent" Command="{Binding GravarCommand}" />
        <Button Content="Aprovar" Command="{Binding AprovarCommand}" />
        <Button Content="Recusar" Command="{Binding RecusarCommand}" />
        <Button Content="Reabrir" Command="{Binding ReabrirCommand}" />
        <Button Content="Excluir" Command="{Binding ExcluirCommand}" />
      </StackPanel>
      <TextBlock FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                 Text="A cotação aprovada pode ser escolhida na hora de digitar o CT-e." />
      <c:MensagensView />
    </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
