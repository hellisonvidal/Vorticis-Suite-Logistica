<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Vorticis.Desktop.Comum.Views" xmlns:vm="using:Vorticis.Frota.Desktop.ViewModels"
             x:Class="Vorticis.Frota.Desktop.Views.DiariasView" x:DataType="vm:DiariasViewModel">
  <Grid ColumnDefinitions="*,12,430" RowDefinitions="Auto,Auto,*" Margin="8">
    <StackPanel Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
      <TextBlock Classes="titulo" Text="Diárias" VerticalAlignment="Center" />
      <TextBlock Text="Período" VerticalAlignment="Center" />
      <CalendarDatePicker SelectedDate="{Binding Inicio}" Width="130" />
      <TextBlock Text="a" VerticalAlignment="Center" />
      <CalendarDatePicker SelectedDate="{Binding Fim}" Width="130" />
      <TextBlock Text="Colaborador" VerticalAlignment="Center" />
      <ComboBox ItemsSource="{Binding FiltroColaboradores}" SelectedItem="{Binding FiltroColaborador}" Width="170" />
      <TextBlock Text="Frota" VerticalAlignment="Center" />
      <ComboBox ItemsSource="{Binding FiltroFrotas}" SelectedItem="{Binding FiltroFrota}" Width="170" />
    </StackPanel>
    <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding Totais}" FontSize="12" Margin="0,0,0,6" />
    <DataGrid Grid.Row="2" ItemsSource="{Binding Lista}" SelectedItem="{Binding Selecionada}" IsReadOnly="True" AutoGenerateColumns="False">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Nº" Binding="{ReflectionBinding Numero}" Width="55" />
        <DataGridTextColumn Header="Data" Binding="{ReflectionBinding Data}" Width="90" />
        <DataGridTextColumn Header="Colaborador" Binding="{ReflectionBinding Colaborador}" Width="*" />
        <DataGridTextColumn Header="Função" Binding="{ReflectionBinding Funcao}" Width="85" />
        <DataGridTextColumn Header="Diária" Binding="{ReflectionBinding Diaria}" Width="140" />
        <DataGridTextColumn Header="Placa" Binding="{ReflectionBinding Placa}" Width="85" />
        <DataGridTextColumn Header="Frota" Binding="{ReflectionBinding Frota}" Width="110" />
        <DataGridTextColumn Header="Total" Binding="{ReflectionBinding Total}" Width="90" />
        <DataGridTextColumn Header="Adiantamento" Binding="{ReflectionBinding Adiantamento}" Width="100" />
        <DataGridTextColumn Header="Saldo do acerto" Binding="{ReflectionBinding Saldo}" Width="140" />
        <DataGridTextColumn Header="Situação" Binding="{ReflectionBinding Situacao}" Width="85" />
      </DataGrid.Columns>
    </DataGrid>
    <ScrollViewer Grid.Row="2" Grid.Column="2">
    <StackPanel Spacing="6" IsEnabled="{Binding PodeEditar}">
      <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
        <TextBlock Classes="rotulo" Text="Data" />
        <CalendarDatePicker Grid.Column="1" SelectedDate="{Binding Data}" Width="140" />
        <TextBlock Grid.Row="1" Classes="rotulo" Text="Colaborador" />
        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding MotoristasOpcoes}" SelectedItem="{Binding Colaborador}" HorizontalAlignment="Stretch" />
        <TextBlock Grid.Row="2" Classes="rotulo" Text="Função" />
        <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{x:Static vm:DiariasViewModel.Funcoes}" SelectedItem="{Binding Funcao}" Width="160" />
        <TextBlock Grid.Row="3" Classes="rotulo" Text="Veículo" />
        <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding VeiculosOpcoes}" SelectedItem="{Binding Veiculo}" HorizontalAlignment="Stretch" />
        <TextBlock Grid.Row="4" Classes="rotulo" Text="Frota" />
        <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding FrotasOpcoes}" SelectedItem="{Binding Frota}" HorizontalAlignment="Stretch" />
        <TextBlock Grid.Row="5" Classes="rotulo" Text="Rota" />
        <ComboBox Grid.Row="5" Grid.Column="1" ItemsSource="{Binding RotasOpcoes}" SelectedItem="{Binding Rota}" HorizontalAlignment="Stretch" />
        <TextBlock Grid.Row="6" Classes="rotulo" Text="Viagem" />
        <ComboBox Grid.Row="6" Grid.Column="1" ItemsSource="{Binding ViagensOpcoes}" SelectedItem="{Binding Viagem}" HorizontalAlignment="Stretch" />
        <TextBlock Grid.Row="7" Classes="rotulo" Text="Tipo da diária" />
        <ComboBox Grid.Row="7" Grid.Column="1" ItemsSource="{x:Static vm:DiariasViewModel.Tipos}" SelectedItem="{Binding Tipo}" Width="160" />
        <TextBlock Grid.Row="8" Classes="rotulo" Text="Quantidade / valor" />
        <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal" Spacing="6">
          <TextBox Text="{Binding Quantidade}" Width="80" Watermark="Qtd." />
          <TextBox Text="{Binding ValorUnitario}" Width="120" Watermark="Valor unitário" />
          <TextBlock Text="{Binding Total}" VerticalAlignment="Center" FontWeight="SemiBold" />
        </StackPanel>
        <TextBlock Grid.Row="9" Classes="rotulo" Text="Adiantamento" />
        <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding Adiantamento}" Width="140" HorizontalAlignment="Left" />
        <TextBlock Grid.Row="10" Classes="rotulo" Text="Centro de custo" />
        <ComboBox Grid.Row="10" Grid.Column="1" ItemsSource="{Binding CentrosOpcoes}" SelectedItem="{Binding Centro}" HorizontalAlignment="Stretch" />
        <TextBlock Grid.Row="11" Classes="rotulo" Text="Observação" />
        <TextBox Grid.Row="11" Grid.Column="1" Text="{Binding Observacao}" />
      </Grid>
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Button Content="Nova diária" Command="{Binding NovaCommand}" />
        <Button Content="Gravar" Classes="accent" Command="{Binding GravarCommand}" />
        <Button Content="Excluir" Command="{Binding ExcluirCommand}" />
      </StackPanel>
      <Separator />
      <TextBlock Text="Pagamento e acerto da diária selecionada" FontWeight="SemiBold" />
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock Text="Vencimento" VerticalAlignment="Center" />
        <CalendarDatePicker SelectedDate="{Binding Vencimento}" Width="130" />
        <Button Content="Pagar (gerar conta a pagar)" Command="{Binding PagarCommand}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock Text="Valor gasto" VerticalAlignment="Center" />
        <TextBox Text="{Binding ValorGasto}" Width="120" />
        <Button Content="Acertar" Command="{Binding AcertarCommand}" />
      </StackPanel>
      <TextBlock FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                 Text="Valor unitário em branco usa a tabela de Cadastros › Parâmetros › Frota. Pagar gera a conta a pagar do adiantamento (ou do total, se não houve adiantamento). Acertar: saldo = adiantamento - valor gasto (positivo, o colaborador devolve; negativo, a empresa paga a diferença)." />
      <c:MensagensView />
    </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
