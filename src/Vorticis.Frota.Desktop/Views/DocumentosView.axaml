<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Vorticis.Desktop.Comum.Views" xmlns:vm="using:Vorticis.Frota.Desktop.ViewModels"
             x:Class="Vorticis.Frota.Desktop.Views.DocumentosView" x:DataType="vm:DocumentosViewModel">
  <Grid ColumnDefinitions="*,12,380" RowDefinitions="Auto,*" Margin="8">
    <TextBlock Grid.ColumnSpan="3" Classes="titulo" Text="Documentos e vencimentos" Margin="0,0,0,8" />
    <DataGrid Grid.Row="1" ItemsSource="{Binding Lista}" SelectedItem="{Binding Selecionado}" IsReadOnly="True" AutoGenerateColumns="False">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Documento" Binding="{ReflectionBinding Tipo}" Width="180" />
        <DataGridTextColumn Header="De" Binding="{ReflectionBinding Dono}" Width="*" />
        <DataGridTextColumn Header="Número" Binding="{ReflectionBinding Numero}" Width="120" />
        <DataGridTextColumn Header="Vencimento" Binding="{ReflectionBinding Vencimento}" Width="100" />
        <DataGridTextColumn Header="Valor" Binding="{ReflectionBinding Valor}" Width="100" />
        <DataGridTextColumn Header="Situação" Binding="{ReflectionBinding Situacao}" Width="150" />
      </DataGrid.Columns>
    </DataGrid>
    <StackPanel Grid.Row="1" Grid.Column="2" Spacing="6" IsEnabled="{Binding PodeEditar}">
      <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
        <TextBlock Classes="rotulo" Text="Documento" />
        <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:DocumentosViewModel.Tipos}" SelectedItem="{Binding Tipo}" HorizontalAlignment="Stretch" />
        <TextBlock Grid.Row="1" Classes="rotulo" Text="Veículo" />
        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding VeiculosOpcoes}" SelectedItem="{Binding Veiculo}" HorizontalAlignment="Stretch" />
        <TextBlock Grid.Row="2" Classes="rotulo" Text="ou motorista" />
        <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding MotoristasOpcoes}" SelectedItem="{Binding Motorista}" HorizontalAlignment="Stretch" />
        <TextBlock Grid.Row="3" Classes="rotulo" Text="Número" />
        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Numero}" />
        <TextBlock Grid.Row="4" Classes="rotulo" Text="Vencimento" />
        <CalendarDatePicker Grid.Row="4" Grid.Column="1" SelectedDate="{Binding Vencimento}" Width="140" />
        <TextBlock Grid.Row="5" Classes="rotulo" Text="Valor" />
        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Valor}" Width="140" HorizontalAlignment="Left" />
        <TextBlock Grid.Row="6" Classes="rotulo" Text="Observação" />
        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Observacao}" />
      </Grid>
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Button Content="Novo documento" Command="{Binding NovoCommand}" />
        <Button Content="Gravar" Classes="accent" Command="{Binding GravarCommand}" />
        <Button Content="Excluir" Command="{Binding ExcluirCommand}" />
      </StackPanel>
      <TextBlock FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                 Text="Sem veículo e sem motorista, o documento é da própria transportadora (ex.: RNTRC da empresa). Ao renovar, altere o vencimento." />
      <c:MensagensView />
    </StackPanel>
  </Grid>
</UserControl>
