<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Vorticis.Desktop.Comum.Views" xmlns:vm="using:Vorticis.Frota.Desktop.ViewModels"
             x:Class="Vorticis.Frota.Desktop.Views.ManifestosView" x:DataType="vm:ManifestosViewModel">
  <UserControl.Styles>
    <Style Selector="Border.cartao">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
  </UserControl.Styles>
  <!-- Manifestos de carga: a lista com filtros e o painel dos valores; Novo manifesto e Abrir (duplo clique ou Enter) editam numa janela pop-up. -->
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="8">
    <TextBlock Classes="titulo" Text="Manifestos de carga (MDF-e)" Margin="0,0,0,6" />
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
      <TextBlock Text="Período" VerticalAlignment="Center" />
      <CalendarDatePicker SelectedDate="{Binding Inicio}" Width="130" />
      <TextBlock Text="a" VerticalAlignment="Center" />
      <CalendarDatePicker SelectedDate="{Binding Fim}" Width="130" />
      <TextBlock Text="Situação" VerticalAlignment="Center" />
      <ComboBox ItemsSource="{x:Static vm:ManifestosViewModel.FiltroSituacoes}" SelectedItem="{Binding FiltroSituacao}" Width="140" />
      <TextBox Text="{Binding FiltroTexto}" Width="260" Watermark="Número, chave, placa, motorista ou UF" />
    </StackPanel>
    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,6">
      <Border Classes="cartao"><StackPanel><TextBlock Text="Manifestos listados" FontSize="11" /><TextBlock Text="{Binding PainelQuantidade}" FontSize="18" FontWeight="Bold" /></StackPanel></Border>
      <Border Classes="cartao"><StackPanel><TextBlock Text="CT-e nos manifestos" FontSize="11" /><TextBlock Text="{Binding PainelCtes}" FontSize="18" FontWeight="Bold" /></StackPanel></Border>
      <Border Classes="cartao"><StackPanel><TextBlock Text="Peso" FontSize="11" /><TextBlock Text="{Binding PainelPeso}" FontSize="18" FontWeight="Bold" /></StackPanel></Border>
      <Border Classes="cartao"><StackPanel><TextBlock Text="Valor da carga" FontSize="11" /><TextBlock Text="{Binding PainelCarga}" FontSize="18" FontWeight="Bold" /></StackPanel></Border>
      <Border Classes="cartao"><StackPanel><TextBlock Text="Frete dos CT-e" FontSize="11" /><TextBlock Text="{Binding PainelFrete}" FontSize="18" FontWeight="Bold" /></StackPanel></Border>
    </StackPanel>
    <StackPanel Grid.Row="3" Spacing="6" Margin="0,0,0,6">
      <TextBlock Text="{Binding Totais}" FontSize="12" />
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Button Content="Novo manifesto" Classes="accent" Command="{Binding NovoManifestoCommand}" IsEnabled="{Binding PodeEditar}" />
        <Button Content="Abrir" Command="{Binding AbrirCommand}" ToolTip.Tip="Abre o manifesto selecionado (também com duplo clique ou Enter)" />
        <Button Content="Imprimir (PDF)" Command="{Binding ImprimirCommand}" />
      </StackPanel>
    </StackPanel>
    <DataGrid Name="ListaManifestos" Grid.Row="4" ItemsSource="{Binding Lista}" SelectedItem="{Binding Selecionado}" IsReadOnly="True" AutoGenerateColumns="False"
              DoubleTapped="AoDuploClique" KeyDown="AoTeclar">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Nº" Binding="{ReflectionBinding Numero}" Width="70" />
        <DataGridTextColumn Header="Emissão" Binding="{ReflectionBinding Emissao}" Width="90" />
        <DataGridTextColumn Header="Placa" Binding="{ReflectionBinding Placa}" Width="90" />
        <DataGridTextColumn Header="Motorista" Binding="{ReflectionBinding Motorista}" Width="170" />
        <DataGridTextColumn Header="Percurso" Binding="{ReflectionBinding Percurso}" Width="*" MinWidth="160" />
        <DataGridTextColumn Header="CT-e" Binding="{ReflectionBinding Ctes}" Width="60" />
        <DataGridTextColumn Header="Peso (kg)" Binding="{ReflectionBinding Peso}" Width="90" />
        <DataGridTextColumn Header="Valor da carga" Binding="{ReflectionBinding Valor}" Width="120" />
        <DataGridTextColumn Header="Situação" Binding="{ReflectionBinding Situacao}" Width="160" />
      </DataGrid.Columns>
    </DataGrid>
    <c:MensagensView Grid.Row="5" IsVisible="{Binding !EdicaoAberta}" />
  </Grid>
</UserControl>
