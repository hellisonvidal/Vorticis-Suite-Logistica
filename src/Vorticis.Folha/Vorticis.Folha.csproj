<Project Sdk="Microsoft.NET.Sdk">
  <!-- Regras e serviços do módulo Folha (domínio, aplicação e repositórios); a interface fica em Vorticis.Folha.Desktop. -->
  <ItemGroup>
    <ProjectReference Include="..\Vorticis.Domain\Vorticis.Domain.csproj" />
    <ProjectReference Include="..\Vorticis.Application\Vorticis.Application.csproj" />
    <ProjectReference Include="..\Vorticis.Infra\Vorticis.Infra.csproj" />
    <PackageReference Include="System.Security.Cryptography.Xml" />
  </ItemGroup>
  <ItemGroup>
    <!-- Tabelas legais de referência (mesmas vigências da migração 040) -->
    <EmbeddedResource Include="Dados\*.json" LogicalName="Folha.%(Filename)%(Extension)" />
    <!-- XSDs oficiais do eSocial S-1.3 (pacote 2026-07-01) e do pacote de comunicação v1.6: validação local dos eventos e dos lotes -->
    <EmbeddedResource Include="Esocial\Xsd\*.xsd" LogicalName="Esocial.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
