<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Vorticis.Desktop.Comum.Views"
             xmlns:vm="using:Vorticis.Desktop.ViewModels"
             xmlns:v="using:Vorticis.Desktop.Views"
             x:Class="Vorticis.Desktop.Views.LancamentoDigitacaoView"
             x:DataType="vm:LancamentoViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.rot">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#44506A" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.nome">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#1F3A5F" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="10,0,0,0" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBox.valor">
      <Setter Property="TextAlignment" Value="Right" />
    </Style>
    <Style Selector="Border#Detalhes TextBox, Border#Detalhes AutoCompleteBox">
      <Setter Property="MinHeight" Value="28" />
    </Style>
  </UserControl.Styles>

  <!-- Digitação na vertical: os campos da partida atual um embaixo do outro (com o nome da conta ao lado), as partidas do
       lançamento numa lista logo abaixo e as contas analíticas à direita. Tudo cabe na janela; nada fica escondido à direita. -->
  <Grid ColumnDefinitions="*,250" RowDefinitions="Auto,*,Auto,Auto" Margin="8,4,8,6">
    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,4">
      <TextBlock Classes="titulo" Text="{Binding TituloDigitacao}" VerticalAlignment="Center" />
      <Border Background="#FFF4CE" BorderBrush="#E0B000" BorderThickness="1" CornerRadius="3" Padding="8,1" IsVisible="{Binding EmEdicao}">
        <TextBlock Text="{Binding TextoEdicao}" FontSize="11" Foreground="#5A4500" VerticalAlignment="Center" />
      </Border>
    </StackPanel>

    <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*">
      <!-- Formulário da partida selecionada (Enter avança de campo; seta para baixo vai à próxima partida) -->
      <Border Name="Detalhes" Background="#F7F9FC" BorderBrush="#D5DDE8" BorderThickness="1" CornerRadius="3" Padding="10,6" IsEnabled="{Binding PodeDigitar}">
        <Grid DataContext="{Binding LinhaSelecionada}" x:DataType="vm:LinhaLancamentoViewModel" ColumnDefinitions="130,Auto,*" RowSpacing="4"
              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
          <TextBlock Classes="rot" Text="Data" />
          <TextBox Grid.Column="1" Tag="data" Text="{Binding Data}" c:Mascara.Tipo="Data" Width="120" HorizontalAlignment="Left" />

          <TextBlock Classes="rot" Grid.Row="1" Text="Conta a débito (D)" />
          <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6">
            <TextBox Tag="reduzido" Text="{Binding Reduzido}" Width="70" Watermark="Red." ToolTip.Tip="Código reduzido da conta" />
            <AutoCompleteBox Tag="conta" Text="{Binding Conta}" Width="190" Watermark="Código ou nome"
                             ItemsSource="{Binding $parent[UserControl].((vm:LancamentoViewModel)DataContext).TodasContas}"
                             FilterMode="Custom" ItemFilter="{x:Static v:LancamentoDigitacaoView.FiltroConta}"
                             ValueMemberBinding="{ReflectionBinding Codigo}" MinimumPrefixLength="2" MaxDropDownHeight="260">
              <AutoCompleteBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ContaSelecionavel"><TextBlock Text="{Binding Rotulo}" FontFamily="Consolas, Menlo, monospace" /></DataTemplate>
              </AutoCompleteBox.ItemTemplate>
            </AutoCompleteBox>
          </StackPanel>
          <TextBlock Classes="nome" Grid.Row="1" Grid.Column="2" Text="{Binding NomeConta}" />

          <TextBlock Classes="rot" Grid.Row="2" Text="Conta a crédito (C)" />
          <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="6">
            <TextBox Tag="reduzidocredito" Text="{Binding ReduzidoCredito}" Width="70" Watermark="Red." ToolTip.Tip="Código reduzido da conta" />
            <AutoCompleteBox Tag="contacredito" Text="{Binding ContaCredito}" Width="190" Watermark="Código ou nome"
                             ItemsSource="{Binding $parent[UserControl].((vm:LancamentoViewModel)DataContext).TodasContas}"
                             FilterMode="Custom" ItemFilter="{x:Static v:LancamentoDigitacaoView.FiltroConta}"
                             ValueMemberBinding="{ReflectionBinding Codigo}" MinimumPrefixLength="2" MaxDropDownHeight="260">
              <AutoCompleteBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ContaSelecionavel"><TextBlock Text="{Binding Rotulo}" FontFamily="Consolas, Menlo, monospace" /></DataTemplate>
              </AutoCompleteBox.ItemTemplate>
            </AutoCompleteBox>
          </StackPanel>
          <TextBlock Classes="nome" Grid.Row="2" Grid.Column="2" Text="{Binding NomeContaCredito}" />

          <TextBlock Classes="rot" Grid.Row="3" Text="Valor" />
          <TextBox Grid.Row="3" Grid.Column="1" Tag="valor" Classes="valor" Text="{Binding Valor}" Width="150" HorizontalAlignment="Left" />

          <TextBlock Classes="rot" Grid.Row="4" Text="Documento" />
          <TextBox Grid.Row="4" Grid.Column="1" Tag="documento" Text="{Binding Documento}" Width="150" HorizontalAlignment="Left" />

          <TextBlock Classes="rot" Grid.Row="5" Text="Histórico padrão" />
          <TextBox Grid.Row="5" Grid.Column="1" Tag="codhistorico" Text="{Binding CodigoHistorico}" Width="70" HorizontalAlignment="Left"
                   ToolTip.Tip="Código do histórico padrão (Cadastros › Históricos)" />

          <TextBlock Classes="rot" Grid.Row="6" Text="Histórico" />
          <TextBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Tag="historico" Text="{Binding Historico}" />

          <TextBlock Classes="rot" Grid.Row="7" Text="Centro de custo" />
          <TextBox Grid.Row="7" Grid.Column="1" Tag="centrocusto" Text="{Binding CentroCusto}" Width="100" HorizontalAlignment="Left" />

          <TextBlock Classes="rot" Grid.Row="8" Text="Participante" IsVisible="{Binding $parent[UserControl].((vm:LancamentoViewModel)DataContext).UsaParticipantes}" />
          <TextBox Grid.Row="8" Grid.Column="1" Tag="participante" Text="{Binding Participante}" Width="100" HorizontalAlignment="Left"
                   IsVisible="{Binding $parent[UserControl].((vm:LancamentoViewModel)DataContext).UsaParticipantes}"
                   ToolTip.Tip="Participante (cliente/fornecedor) — plano de contas com participantes" />
          <TextBlock Classes="nome" Grid.Row="8" Grid.Column="2" Text="{Binding NomeParticipante}"
                     IsVisible="{Binding $parent[UserControl].((vm:LancamentoViewModel)DataContext).UsaParticipantes}" />
        </Grid>
      </Border>

      <!-- Partidas deste lançamento: uma linha com débito e crédito é um lançamento; linhas com uma conta só somam um lançamento único -->
      <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,6,0,2">
        <TextBlock Text="Partidas deste lançamento" FontWeight="SemiBold" Foreground="#1F3A5F" VerticalAlignment="Center"
                   ToolTip.Tip="Clique numa partida para editá-la no formulário acima" />
        <Button Content="Nova partida (↓)" Command="{Binding NovaPartidaCommand}" IsVisible="{Binding PodeDigitar}" Padding="8,2" />
        <Button Content="Excluir partida (Ctrl+Del)" Command="{Binding ExcluirLinhaCommand}" IsVisible="{Binding PodeDigitar}" Padding="8,2" />
      </StackPanel>
      <ListBox Grid.Row="2" Name="LinhasLancamento" ItemsSource="{Binding Linhas}" SelectedItem="{Binding LinhaSelecionada}" MinHeight="70">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:LinhaLancamentoViewModel">
            <Grid ColumnDefinitions="90,*,*,110,*">
              <TextBlock Text="{Binding Data}" FontSize="12" />
              <TextBlock Grid.Column="1" Text="{Binding Conta, StringFormat='D {0}'}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding NomeConta}" />
              <TextBlock Grid.Column="2" Text="{Binding ContaCredito, StringFormat='C {0}'}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding NomeContaCredito}" />
              <TextBlock Grid.Column="3" Text="{Binding Valor}" FontSize="12" HorizontalAlignment="Right" Margin="0,0,10,0" />
              <TextBlock Grid.Column="4" Text="{Binding Historico}" FontSize="12" TextTrimming="CharacterEllipsis" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>

    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="0,6,0,2">
      <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
        <TextBlock Text="{Binding TotalDebito, StringFormat='Débitos: {0}'}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding TotalCredito, StringFormat='Créditos: {0}'}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding Diferenca, StringFormat='Diferença: {0}'}" FontWeight="SemiBold" VerticalAlignment="Center"
                   Foreground="{Binding Balanceado, Converter={x:Static c:Conversores.OkOuErro}}" />
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <TextBox Text="{Binding MotivoEstorno}" Watermark="Motivo do estorno" Width="200" IsVisible="{Binding SomenteLeitura}" />
        <Button Name="BotaoEstornar" Content="Estornar" Command="{Binding EstornarCommand}" IsVisible="{Binding SomenteLeitura}" />
        <Button Name="BotaoLimpar" Content="Limpar" Command="{Binding LimparCommand}" IsVisible="{Binding PodeDigitar}" />
        <Button Name="BotaoCancelar" Content="{Binding SomenteLeitura, Converter={x:Static v:LancamentoDigitacaoView.RotuloFechar}}" Command="{Binding CancelarDigitacaoCommand}" IsCancel="True" />
        <Button Name="BotaoSalvar" Content="Salvar (Ctrl+S)" Command="{Binding SalvarCommand}" HotKey="Ctrl+S" Classes="accent" IsVisible="{Binding PodeDigitar}" />
      </StackPanel>
    </Grid>

    <c:MensagensView Grid.Row="3" />

    <DockPanel Grid.Column="1" Grid.RowSpan="4" Margin="10,0,0,0" IsEnabled="{Binding PodeDigitar}">
      <TextBlock DockPanel.Dock="Top" Text="Contas analíticas" FontWeight="SemiBold"
                 ToolTip.Tip="Clique numa conta para preenchê-la na partida atual" />
      <TextBox DockPanel.Dock="Top" Text="{Binding FiltroConta}" Watermark="Filtrar: reduzido, código ou nome" Margin="0,4" />
      <ListBox ItemsSource="{Binding Contas}" SelectedItem="{Binding ContaSelecionada}" Focusable="False">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ContaSelecionavel">
            <TextBlock Text="{Binding Rotulo}" FontSize="11.5" FontFamily="Consolas, Menlo, monospace" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </Grid>
</UserControl>
