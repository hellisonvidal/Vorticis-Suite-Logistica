<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Vorticis.Desktop.App"
             xmlns:vm="using:Vorticis.Desktop.ViewModels"
             xmlns:v="using:Vorticis.Desktop.Views"
             xmlns:c="using:Vorticis.Desktop.Comum.Views"
             RequestedThemeVariant="Light">
  <Application.DataTemplates>
    <!-- Telas comuns (login, empresas, usuários, backup...) -->
    <c:TemplatesComuns />
    <DataTemplate DataType="vm:LancamentoViewModel"><v:LancamentoView /></DataTemplate>
    <DataTemplate DataType="vm:BalanceteViewModel"><v:BalanceteView /></DataTemplate>
    <DataTemplate DataType="vm:RazaoViewModel"><v:RazaoView /></DataTemplate>
    <DataTemplate DataType="vm:DiarioViewModel"><v:DiarioView /></DataTemplate>
    <DataTemplate DataType="vm:PeriodosViewModel"><v:PeriodosView /></DataTemplate>
    <DataTemplate DataType="vm:ReorganizarLancamentosViewModel"><v:ReorganizarLancamentosView /></DataTemplate>
    <DataTemplate DataType="vm:ReorganizarSaldosViewModel"><v:ReorganizarSaldosView /></DataTemplate>
    <DataTemplate DataType="vm:PlanoContasViewModel"><v:PlanoContasView /></DataTemplate>
    <DataTemplate DataType="vm:CentrosCustoViewModel"><v:CentrosCustoView /></DataTemplate>
    <DataTemplate DataType="vm:SaldosIniciaisViewModel"><v:SaldosIniciaisView /></DataTemplate>
    <DataTemplate DataType="vm:EncerramentoViewModel"><v:EncerramentoView /></DataTemplate>
    <DataTemplate DataType="vm:BalancoViewModel"><v:BalancoView /></DataTemplate>
    <DataTemplate DataType="vm:DreViewModel"><v:DreView /></DataTemplate>
    <DataTemplate DataType="vm:LivrosPdfViewModel"><v:LivrosPdfView /></DataTemplate>
    <DataTemplate DataType="vm:ImportacaoReferencialViewModel"><v:ImportacaoReferencialView /></DataTemplate>
    <DataTemplate DataType="vm:ImportacaoPlanoViewModel"><v:ImportacaoPlanoView /></DataTemplate>
    <DataTemplate DataType="vm:ImportacaoPlanilhaViewModel"><v:ImportacaoPlanilhaView /></DataTemplate>
    <DataTemplate DataType="vm:ImportacaoExtratoViewModel"><v:ImportacaoExtratoView /></DataTemplate>
    <DataTemplate DataType="vm:ImportacaoLancamentosPadraoViewModel"><v:ImportacaoLancamentosPadraoView /></DataTemplate>
    <DataTemplate DataType="vm:HistoricosViewModel"><v:HistoricosView /></DataTemplate>
    <DataTemplate DataType="vm:BensViewModel"><v:BensView /></DataTemplate>
    <DataTemplate DataType="vm:ConciliacaoViewModel"><v:ConciliacaoView /></DataTemplate>
    <DataTemplate DataType="vm:DiferencasSaldosViewModel"><v:DiferencasSaldosView /></DataTemplate>
    <DataTemplate DataType="vm:GruposDepreciacaoViewModel"><v:GruposDepreciacaoView /></DataTemplate>
    <DataTemplate DataType="vm:DepreciacaoViewModel"><v:DepreciacaoView /></DataTemplate>
    <DataTemplate DataType="vm:ExportacaoLancamentosViewModel"><v:ExportacaoLancamentosView /></DataTemplate>
    <DataTemplate DataType="vm:DmplViewModel"><v:DmplView /></DataTemplate>
    <DataTemplate DataType="vm:DlpaViewModel"><v:DlpaView /></DataTemplate>
    <DataTemplate DataType="vm:CentroCustoRelatorioViewModel"><v:CentroCustoRelatorioView /></DataTemplate>
    <DataTemplate DataType="vm:RelacaoCustosViewModel"><v:RelacaoCustosView /></DataTemplate>
    <DataTemplate DataType="vm:ReceitaCentroViewModel"><v:ReceitaCentroView /></DataTemplate>
    <DataTemplate DataType="vm:RelatorioDepreciacaoViewModel"><v:RelatorioDepreciacaoView /></DataTemplate>
    <DataTemplate DataType="vm:OrcadoRealizadoViewModel"><v:OrcadoRealizadoView /></DataTemplate>
    <DataTemplate DataType="vm:OrcamentoViewModel"><v:OrcamentoView /></DataTemplate>
    <DataTemplate DataType="vm:TermosViewModel"><v:TermosView /></DataTemplate>
    <DataTemplate DataType="vm:MapeamentoReferencialViewModel"><v:MapeamentoReferencialView /></DataTemplate>
    <DataTemplate DataType="vm:EcdAssistenteViewModel"><v:EcdAssistenteView /></DataTemplate>
    <DataTemplate DataType="vm:EcfAssistenteViewModel"><v:EcfAssistenteView /></DataTemplate>
    <DataTemplate DataType="vm:ConsultasViewModel"><v:ConsultasView /></DataTemplate>
  </Application.DataTemplates>
  <Application.Styles>
    <!-- Tema e estilos comuns da suíte (Vorticis.Desktop.Comum) -->
    <StyleInclude Source="avares://Vorticis.Desktop.Comum/Estilos.axaml" />
  </Application.Styles>
</Application>
