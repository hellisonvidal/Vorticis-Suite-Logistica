<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Vorticis.Desktop.Comum.ViewModels" xmlns:v="using:Vorticis.Desktop.Comum.Views"
             xmlns:m="using:Vorticis.Desktop.Comum.Modulos"
             x:Class="Vorticis.Desktop.Comum.Views.SuiteLadoView" x:DataType="vm:SuiteViewModel">
  <!-- Suite: navegação à esquerda. B = barra lateral com os ícones dos módulos; C = árvore com todas as funções e busca.
       Soltas, recolhem numa faixa fina e abrem quando o mouse se aproxima -->
  <UserControl.Styles>
    <Style Selector="Button.plano">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.plano:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.fundo-icone">
      <Setter Property="Background" Value="#18233A" />
    </Style>
    <Style Selector="Button.plano:pointerover Border.fundo-icone">
      <Setter Property="Background" Value="#22304D" />
    </Style>
    <Style Selector="Button.plano:pointerover Border.realce">
      <Setter Property="Background" Value="#111B30" />
    </Style>
    <Style Selector="Button.no:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#EFF6FF" />
    </Style>
    <Style Selector="Button.no">
      <Setter Property="CornerRadius" Value="7" />
    </Style>
    <Style Selector="TextBlock.modulo">
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="Foreground" Value="#0F172A" />
    </Style>
    <Style Selector="Button.alfinete">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="#7C8BA5" />
    </Style>
    <Style Selector="Button.alfinete:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#18233A" />
    </Style>
    <Style Selector="Button.alfinete.ligado">
      <Setter Property="Foreground" Value="#60A5FA" />
    </Style>
    <Style Selector="TextBox.busca">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="32,6,8,6" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Background" Value="#F1F5F9" />
      <Setter Property="BorderBrush" Value="#E2E8F0" />
    </Style>
  </UserControl.Styles>
  <!-- só depois do login: antes dele não há módulos para navegar nem troca de layout -->
  <Panel Name="Navegacao" Background="Transparent" IsVisible="{Binding Logado}">
    <!-- Recolhida: faixa fina à esquerda; o mouse sobre ela abre a navegação (SuiteLadoView.axaml.cs) -->
    <Border Name="FaixaLateral" Width="10" IsVisible="{Binding MostraFaixaLateral}" ToolTip.Tip="Módulos (aproxime o mouse)">
      <Border.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
          <GradientStop Color="#0A1020" Offset="0" />
          <GradientStop Color="#16223D" Offset="1" />
        </LinearGradientBrush>
      </Border.Background>
      <ItemsControl ItemsSource="{Binding Modulos}" VerticalAlignment="Center">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ModuloSuite">
            <Border Width="4" Height="22" CornerRadius="2" Margin="0,3" Background="{Binding Cor}" HorizontalAlignment="Center" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>
    <Border Name="FaixaArvore" Width="10" Background="#E2E8F0" BorderBrush="#CBD5E1" BorderThickness="0,0,1,0" IsVisible="{Binding MostraFaixaArvore}"
            ToolTip.Tip="Módulos e funções (aproxime o mouse)">
      <ItemsControl ItemsSource="{Binding Modulos}" VerticalAlignment="Center">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ModuloSuite">
            <Border Width="4" Height="22" CornerRadius="2" Margin="0,3" Background="{Binding Cor}" HorizontalAlignment="Center" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

    <!-- B: barra lateral -->
    <Border Name="BarraLateral" Width="92" IsVisible="{Binding MostraBarraLateral}">
      <Border.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
          <GradientStop Color="#0A1020" Offset="0" />
          <GradientStop Color="#121C33" Offset="1" />
        </LinearGradientBrush>
      </Border.Background>
      <DockPanel>
        <Border DockPanel.Dock="Top" Margin="0,14,0,16" Width="46" Height="46" CornerRadius="14" HorizontalAlignment="Center"
                ToolTip.Tip="{Binding Nome}" BoxShadow="0 0 18 0 #556366F1">
          <Border.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
              <GradientStop Color="#38BDF8" Offset="0" />
              <GradientStop Color="#6366F1" Offset="1" />
            </LinearGradientBrush>
          </Border.Background>
          <v:IconeVetorial Width="26" Height="26" Dados="{x:Static m:IconesModulos.Marca}" Preenchimento="White" />
        </Border>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,14" Spacing="4" HorizontalAlignment="Center">
          <v:SuiteEscolhaLayoutView Escuro="True" SoIcone="True" HorizontalAlignment="Center" />
          <Button Classes="alfinete" Classes.ligado="{Binding LateralFixa}" Command="{Binding AlternarFixaCommand}" HorizontalAlignment="Center"
                  ToolTip.Tip="Fixar: a barra fica sempre aberta. Soltar: ela se esconde e abre ao aproximar o mouse">
            <StackPanel Spacing="2">
              <v:IconeVetorial Width="18" Height="18" Dados="{x:Static m:IconesModulos.Fixar}" Preenchimento="{Binding $parent[Button].Foreground}" HorizontalAlignment="Center" />
              <TextBlock Text="{Binding TextoFixar}" FontSize="10" Foreground="{Binding $parent[Button].Foreground}" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Modulos}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ModuloSuite">
                <Button Classes="plano" Margin="0,0,0,6" ToolTip.Tip="{Binding Subtitulo}"
                        Command="{Binding $parent[UserControl].((vm:SuiteViewModel)DataContext).TrocarCommand}" CommandParameter="{Binding}">
                  <Grid>
                    <Border Classes="realce" Margin="8,0" CornerRadius="14" Background="Transparent" />
                    <Border Margin="8,0" CornerRadius="14" Background="#1A2643" IsVisible="{Binding Ativo}" />
                    <Border Width="4" Height="30" HorizontalAlignment="Left" CornerRadius="0,3,3,0" Background="{Binding Cor}" IsVisible="{Binding Ativo}" />
                    <StackPanel Margin="0,8" Spacing="5">
                      <Panel Width="46" Height="46" HorizontalAlignment="Center">
                        <Border CornerRadius="13" Background="{Binding Gradiente}" IsVisible="{Binding Ativo}" BoxShadow="0 6 14 0 #66000000" />
                        <Border Classes="fundo-icone" CornerRadius="13" IsVisible="{Binding !Ativo}" />
                        <v:IconeVetorial Width="24" Height="24" Geometria="{Binding Icone}" Preenchimento="White" IsVisible="{Binding Ativo}" />
                        <v:IconeVetorial Width="24" Height="24" Geometria="{Binding Icone}" Preenchimento="{Binding Cor}" IsVisible="{Binding !Ativo}" />
                        <TextBlock Text="{Binding Sigla}" FontSize="15" FontWeight="Bold" Foreground="White" IsVisible="{Binding SemIcone}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Border MinWidth="18" Height="18" CornerRadius="9" Background="#EF4444" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="4,0"
                                Margin="0,-5,-6,0" IsVisible="{Binding TemAbertas}" ToolTip.Tip="Funções abertas neste módulo" BorderBrush="#0A1020" BorderThickness="2">
                          <TextBlock Text="{Binding Abertas}" FontSize="9.5" FontWeight="Bold" Foreground="White"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                      </Panel>
                      <TextBlock Text="{Binding Nome}" FontSize="10.5" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" MaxWidth="84" IsVisible="{Binding Ativo}" />
                      <TextBlock Text="{Binding Nome}" FontSize="10.5" Foreground="#93A1B8" HorizontalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" MaxWidth="84" IsVisible="{Binding !Ativo}" />
                    </StackPanel>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- C: árvore com todos os módulos e funções -->
    <Border Name="PainelArvore" Width="286" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" IsVisible="{Binding MostraArvore}"
            BoxShadow="4 0 18 0 #120F172A">
      <DockPanel Margin="12,12,8,10">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="2,0,0,12">
          <Border Width="34" Height="34" CornerRadius="10">
            <Border.Background>
              <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#38BDF8" Offset="0" />
                <GradientStop Color="#6366F1" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
            <v:IconeVetorial Width="20" Height="20" Dados="{x:Static m:IconesModulos.Marca}" Preenchimento="White" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="VORTICIS" FontSize="10" FontWeight="Bold" Foreground="#2563EB" LetterSpacing="2" />
            <TextBlock Text="{Binding Nome}" FontSize="13.5" FontWeight="SemiBold" Foreground="#0F172A" />
          </StackPanel>
        </StackPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,4,0">
          <Button DockPanel.Dock="Right" Command="{Binding AlternarFixaCommand}" Padding="10,5" CornerRadius="9"
                  ToolTip.Tip="Fixar: o painel fica sempre aberto. Soltar: ele se esconde e abre ao aproximar o mouse">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <v:IconeVetorial Width="14" Height="14" Dados="{x:Static m:IconesModulos.Fixar}" Preenchimento="#334155" />
              <TextBlock Text="{Binding TextoFixar}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <v:SuiteEscolhaLayoutView HorizontalAlignment="Left" />
        </DockPanel>
        <Panel DockPanel.Dock="Top" Margin="0,0,4,10">
          <TextBox Name="CampoBusca" Classes="busca" Text="{Binding Busca}" Watermark="Ir para… (Ctrl+K)" VerticalContentAlignment="Center" />
          <v:IconeVetorial Width="15" Height="15" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"
                           Dados="{x:Static m:IconesModulos.Busca}" Preenchimento="#94A3B8" />
        </Panel>
        <TextBlock DockPanel.Dock="Top" Text="MÓDULOS" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" LetterSpacing="1.5" Margin="4,0,0,6"
                   IsVisible="{Binding !Buscando}" />
        <Panel>
          <ListBox Name="ResultadosBusca" ItemsSource="{Binding Resultados}" IsVisible="{Binding Buscando}" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:NoSuite">
                <Button Classes="plano no" Padding="6,5" Command="{Binding $parent[UserControl].((vm:SuiteViewModel)DataContext).AbrirFuncaoCommand}" CommandParameter="{Binding}">
                  <StackPanel Orientation="Horizontal" Spacing="9">
                    <Border Width="24" Height="24" CornerRadius="7" Background="{Binding Modulo.Gradiente}" VerticalAlignment="Top">
                      <v:IconeVetorial Width="14" Height="14" Geometria="{Binding Modulo.Icone}" Preenchimento="White" />
                    </Border>
                    <StackPanel Spacing="1">
                      <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold" Foreground="#0F172A" />
                      <TextBlock Text="{Binding Caminho}" FontSize="11" Foreground="#64748B" TextTrimming="CharacterEllipsis" MaxWidth="210" />
                    </StackPanel>
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TreeView Name="ArvoreModulos" ItemsSource="{Binding Arvore}" IsVisible="{Binding !Buscando}">
            <TreeView.ItemTemplate>
              <TreeDataTemplate x:DataType="vm:NoSuite" ItemsSource="{Binding Filhos}">
                <Button Classes="plano no" Padding="4,3" Command="{Binding $parent[UserControl].((vm:SuiteViewModel)DataContext).AbrirFuncaoCommand}" CommandParameter="{Binding}">
                  <StackPanel Orientation="Horizontal" Spacing="9">
                    <Border Width="24" Height="24" CornerRadius="7" Background="{Binding Modulo.Gradiente}" IsVisible="{Binding EhModulo}">
                      <v:IconeVetorial Width="14" Height="14" Geometria="{Binding Modulo.Icone}" Preenchimento="White" />
                    </Border>
                    <TextBlock Text="{Binding Titulo}" VerticalAlignment="Center" Classes.modulo="{Binding EhModulo}" />
                  </StackPanel>
                </Button>
              </TreeDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
        </Panel>
      </DockPanel>
    </Border>
  </Panel>
</UserControl>
