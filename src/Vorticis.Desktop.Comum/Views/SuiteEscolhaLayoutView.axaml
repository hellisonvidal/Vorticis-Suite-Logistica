<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Vorticis.Desktop.Comum.ViewModels"
             x:Class="Vorticis.Desktop.Comum.Views.SuiteEscolhaLayoutView" x:DataType="vm:SuiteViewModel">
  <!-- Botão "Layout" da Suite, presente em todos os layouts (também em Exibir e em Configurações) -->
  <Button Name="BotaoLayout" Padding="10,4" Background="Transparent" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8"
          ToolTip.Tip="Mudar o layout da Suite (abas, barra lateral, árvore ou painel)">
    <StackPanel Orientation="Horizontal" Spacing="6">
      <TextBlock Text="⚙" FontSize="14" VerticalAlignment="Center" />
      <TextBlock Text="Layout" VerticalAlignment="Center" />
    </StackPanel>
    <Button.Flyout>
      <MenuFlyout>
        <MenuItem Header="A – Abas no topo" Command="{Binding EscolherLayoutCommand}" CommandParameter="{x:Static vm:LayoutSuite.Abas}" />
        <MenuItem Header="B – Barra lateral (padrão)" Command="{Binding EscolherLayoutCommand}" CommandParameter="{x:Static vm:LayoutSuite.Lateral}" />
        <MenuItem Header="C – Árvore com busca" Command="{Binding EscolherLayoutCommand}" CommandParameter="{x:Static vm:LayoutSuite.Arvore}" />
        <MenuItem Header="D – Painel inicial" Command="{Binding EscolherLayoutCommand}" CommandParameter="{x:Static vm:LayoutSuite.Painel}" />
      </MenuFlyout>
    </Button.Flyout>
  </Button>
</UserControl>
