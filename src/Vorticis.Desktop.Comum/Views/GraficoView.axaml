<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Vorticis.Desktop.Comum.Views" xmlns:vm="using:Vorticis.Desktop.Comum.ViewModels"
             x:Class="Vorticis.Desktop.Comum.Views.GraficoView" x:DataType="vm:GraficoViewModel">
  <!-- Relatórios › Gráficos: o gráfico e, embaixo, a tabela com os mesmos números -->
  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="8">
    <TextBlock Classes="titulo" Text="{Binding Titulo}" Margin="0,0,0,6" />
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
      <TextBlock Text="Período" VerticalAlignment="Center" />
      <CalendarDatePicker SelectedDate="{Binding Inicio}" Width="130" />
      <TextBlock Text="a" VerticalAlignment="Center" />
      <CalendarDatePicker SelectedDate="{Binding Fim}" Width="130" />
      <Button Content="Gerar" Classes="accent" Command="{Binding GerarCommand}" />
    </StackPanel>
    <Border Grid.Row="2" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="4">
      <c:GraficoControl x:Name="Grafico" Dados="{Binding Dados}" MinHeight="260" />
    </Border>
    <DataGrid x:Name="Grade" Grid.Row="3" ItemsSource="{Binding Tabela}" IsReadOnly="True" AutoGenerateColumns="False" Height="170" Margin="0,8,0,0" />
    <StackPanel Grid.Row="4" Spacing="4" Margin="0,6,0,0">
      <TextBlock Text="{Binding Nota}" FontSize="11" Foreground="Gray" TextWrapping="Wrap" />
      <c:MensagensView />
    </StackPanel>
  </Grid>
</UserControl>
