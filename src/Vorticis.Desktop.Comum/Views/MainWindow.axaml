<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Vorticis.Desktop.Comum.ViewModels"
        xmlns:views="clr-namespace:Vorticis.Desktop.Comum.Views"
        x:DataType="vm:MainWindowViewModel"
        x:Class="Vorticis.Desktop.Comum.Views.MainWindow"
        Title="Vorticis Suite Logística"
        Width="1400" Height="900"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/vorticis.ico">
    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="Window">
            <Setter Property="Background" Value="{DynamicResource WindowBackground}"/>
        </Style>
    </Window.Styles>

    <DockPanel>
        <views:BarraSuperiorView DockPanel.Dock="Top" DataContext="{Binding BarraSuperior}"/>

        <Panel DockPanel.Dock="Bottom" Height="28" Background="{DynamicResource StatusBarBackground}">
            <TextBlock Text="{Binding StatusBarTexto}" VerticalAlignment="Center" Margin="12,0" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
        </Panel>

        <Panel>
            <TransitioningContentControl Content="{Binding ConteudoAtual}"
                                         PageTransition="{x:Static CrossFade.PageTransition}"
                                         HorizontalContentAlignment="Stretch"
                                         VerticalContentAlignment="Stretch"/>
        </Panel>
    </DockPanel>
</Window>