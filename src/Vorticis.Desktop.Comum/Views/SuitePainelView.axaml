<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Vorticis.Desktop.Comum.ViewModels"
             x:DataType="vm:SuiteViewModel"
             x:Class="Vorticis.Desktop.Comum.Views.SuitePainelView">
    <Design.DataContext>
        <vm:SuiteViewModel />
    </Design.DataContext>

    <Border Classes="PainelSuite" Background="{DynamicResource CardBackground}">
        <Grid RowDefinitions="Auto,*,Auto">
            <Border Grid.Row="0" Classes="CabecalhoPainel" Background="{DynamicResource AccentBrush}">
                <StackPanel Orientation="Horizontal" Spacing="16" Margin="24,16">
                    <TextBlock Text="VORTICIS Suite Logística"
                               FontSize="28" FontWeight="Bold"
                               Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Hoje}"
                               FontSize="14" Foreground="White"
                               VerticalAlignment="Center" Opacity="0.9"/>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Modulos}" Margin="24">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" ItemWidth="320" ItemHeight="180"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ModuloSuite">
                            <Border Classes="CardModulo"
                                    Background="{Binding Cor}"
                                    BorderBrush="{Binding CorBarra}"
                                    IsHitTestVisible="{Binding Vm.Logado}"
                                    Opacity="{Binding Vm.Logado, Converter={x:Static ObjectConverters.BoolToOpacity}}">
                                <Border.InputBindings>
                                    <MouseBinding Command="{Binding $parent[UserControl].DataContext.TrocarCommand}"
                                                  CommandParameter="{Binding}"
                                                  Gesture="LeftClick"/>
                                </Border.InputBindings>
                                <Grid RowDefinitions="Auto,*,Auto">
                                    <Border Grid.Row="0" Background="{Binding CorBarra}" Padding="12">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <TextBlock Text="{Binding Nome}"
                                                       FontSize="18" FontWeight="SemiBold"
                                                       Foreground="White"/>
                                            <TextBlock Text="{Binding Subtitulo}"
                                                       FontSize="12" Foreground="White" Opacity="0.8"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Grid.Row="1" Margin="16" Spacing="8">
                                        <ItemsControl ItemsSource="{Binding Atalhos}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:NoSuite">
                                                    <TextBlock Text="{Binding Titulo}"
                                                               FontSize="13" Foreground="White" Opacity="0.9"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <Border Grid.Row="2" Background="{Binding CorBarra}" Padding="8">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                            <TextBlock Text="📂" FontSize="12"/>
                                            <TextBlock Text="Acessar módulo" FontSize="11" Foreground="White" Opacity="0.7"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="2" Classes="RodapePainel" Background="{DynamicResource SurfaceBackground}" Padding="16,8">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
                    <TextBlock Text="{Binding Saudacao}" FontSize="13" Foreground="{DynamicResource TextSecondary}"/>
                    <TextBlock Text="|" FontSize="13" Foreground="{DynamicResource TextSecondary}"/>
                    <TextBlock Text="{Binding Hoje}" FontSize="13" Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>