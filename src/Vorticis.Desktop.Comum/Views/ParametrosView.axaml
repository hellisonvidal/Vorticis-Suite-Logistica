<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Vorticis.Desktop.Comum.ViewModels"
             xmlns:v="using:Vorticis.Desktop.Comum.Views"
             x:Class="Vorticis.Desktop.Comum.Views.ParametrosView"
             x:DataType="vm:ParametrosViewModel">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="12" Spacing="10" MaxWidth="820" HorizontalAlignment="Left">
      <TextBlock Classes="titulo" Text="{Binding Titulo}" />
      <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="Gray" Text="{Binding Descricao}" />
      <TextBlock Classes="erro" IsVisible="{Binding !PodeGravar}"
                 Text="Seu perfil nesta empresa não permite alterar os parâmetros; você pode apenas consultá-los." />
      <ItemsControl ItemsSource="{Binding Grupos}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:GrupoParametros">
            <Border BorderBrush="#D0D7E2" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,8">
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold" Foreground="#1F3A5F" />
                <TextBlock Text="{Binding Ajuda}" TextWrapping="Wrap" FontSize="11" Foreground="Gray" />
                <ItemsControl ItemsSource="{Binding Campos}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CampoParametro">
                      <StackPanel Spacing="2" Margin="0,4,0,0">
                        <CheckBox Content="{Binding Rotulo}" IsChecked="{Binding Marcado}" IsVisible="{Binding EhSimNao}"
                                  Name="CampoSimNao" />
                        <StackPanel IsVisible="{Binding !EhSimNao}" Spacing="2">
                          <TextBlock Text="{Binding Rotulo}" />
                          <TextBox Text="{Binding Texto}" Width="260" HorizontalAlignment="Left" IsVisible="{Binding EhTexto}" />
                          <CalendarDatePicker SelectedDate="{Binding Data}" Width="180" HorizontalAlignment="Left" IsVisible="{Binding EhData}" />
                          <ComboBox ItemsSource="{Binding Opcoes}" SelectedItem="{Binding Escolha}" Width="320" HorizontalAlignment="Left"
                                    IsVisible="{Binding EhEscolha}">
                            <ComboBox.ItemTemplate>
                              <DataTemplate x:DataType="vm:OpcaoParametro"><TextBlock Text="{Binding Texto}" /></DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                        </StackPanel>
                        <TextBlock Text="{Binding Ajuda}" TextWrapping="Wrap" FontSize="11" Foreground="Gray" IsVisible="{Binding TemAjuda}" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding Atalhos}" IsVisible="{Binding TemAtalhos}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AtalhoParametro">
                      <Button Content="{Binding Texto}" Command="{Binding Abrir}" Margin="0,4,8,0" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Salvar" Classes="accent" Command="{Binding SalvarCommand}" IsEnabled="{Binding PodeGravar}" />
        <Button Content="Descartar alterações" Command="{Binding DescartarCommand}" />
      </StackPanel>
      <v:MensagensView />
    </StackPanel>
  </ScrollViewer>
</UserControl>
