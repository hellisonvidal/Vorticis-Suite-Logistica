<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Vorticis.Desktop.Comum.ViewModels"
             xmlns:v="using:Vorticis.Desktop.Comum.Views"
             x:Class="Vorticis.Desktop.Comum.Views.PreferenciasMenuView"
             x:DataType="vm:PreferenciasMenuViewModel">
  <Grid RowDefinitions="Auto,*,Auto" Margin="12" MaxWidth="820" HorizontalAlignment="Left">
    <StackPanel Grid.Row="0" Spacing="4">
      <TextBlock Classes="titulo" Text="Menus" />
      <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="Gray"
                 Text="Desmarque o que você não quer ver no menu. O item some e a função fica bloqueada (também por atalho de teclado). Parâmetros, Sair e Ajuda não podem ser desmarcados." />
    </StackPanel>
    <TreeView Grid.Row="1" ItemsSource="{Binding Raiz}" Margin="0,8" MinHeight="260">
      <TreeView.ItemTemplate>
        <TreeDataTemplate ItemsSource="{Binding Filhos}" x:DataType="vm:NoMenuViewModel">
          <CheckBox Content="{Binding Rotulo}" IsChecked="{Binding Marcado}" IsEnabled="{Binding Editavel}" />
        </TreeDataTemplate>
      </TreeView.ItemTemplate>
    </TreeView>
    <StackPanel Grid.Row="2" Spacing="8">
      <CheckBox Content="Aplicar para todos os usuários (somente administrador)" IsChecked="{Binding ParaTodos}" IsVisible="{Binding PodeParaTodos}" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Salvar" Classes="accent" Command="{Binding SalvarCommand}" />
        <Button Content="Mostrar todos" Command="{Binding MostrarTodosCommand}" />
        <Button Content="Descartar alterações" Command="{Binding DescartarCommand}" />
      </StackPanel>
      <v:MensagensView />
    </StackPanel>
  </Grid>
</UserControl>
