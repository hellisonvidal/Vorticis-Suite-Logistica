<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Vorticis.Desktop.Comum.ViewModels"
             x:Class="Vorticis.Desktop.Comum.Views.InicioView"
             x:DataType="vm:InicioViewModel">
  <!-- Tela de descanso: nome do programa ao fundo, centralizado -->
  <Border Margin="-8" ClipToBounds="True">
    <Border.Background>
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#F7F9FC" />
        <GradientStop Offset="1" Color="#E6ECF4" />
      </LinearGradientBrush>
    </Border.Background>
    <Grid>
      <Viewbox Stretch="Uniform" Width="300" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel HorizontalAlignment="Center">
          <TextBlock Text="Vorticis" FontSize="96" FontWeight="Bold" Foreground="{Binding PincelDestaque}" Opacity="0.22"
                     HorizontalAlignment="Center" LetterSpacing="2" />
          <TextBlock Text="{Binding NomeCurto}" FontSize="34" FontWeight="SemiBold" Foreground="{Binding PincelDestaque}" Opacity="0.55"
                     HorizontalAlignment="Center" LetterSpacing="14" Margin="0,-10,0,0" />
        </StackPanel>
      </Viewbox>
      <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0" Width="400" Padding="12" CornerRadius="6" Background="#F2FFFFFF"
              BorderBrush="#D0D8E4" BorderThickness="1" IsVisible="{Binding TemProximas}">
        <StackPanel Spacing="6">
          <TextBlock Text="Próximas obrigações" FontWeight="SemiBold" Foreground="#1F3A5F" />
          <ItemsControl ItemsSource="{Binding Proximas}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ProximaObrigacao">
                <Grid ColumnDefinitions="48,*,Auto" Margin="0,2">
                  <TextBlock Text="{Binding Vencimento}" FontWeight="SemiBold" Foreground="{Binding Cor}" />
                  <TextBlock Grid.Column="1" Text="{Binding Nome}" TextTrimming="CharacterEllipsis" FontSize="12" />
                  <TextBlock Grid.Column="2" Text="{Binding Situacao}" FontSize="11" Foreground="{Binding Cor}" Margin="8,0,0,0" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Content="Abrir calendário de obrigações" Command="{Binding AbrirCalendarioCommand}" HorizontalAlignment="Left" />
        </StackPanel>
      </Border>
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24" Spacing="4">
        <TextBlock Text="{Binding Dica}" FontSize="13" Foreground="#44506A" HorizontalAlignment="Center"
                   IsVisible="{Binding Dica, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <TextBlock Text="{Binding Versao}" FontSize="11" Foreground="#8A94A8" HorizontalAlignment="Center" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
