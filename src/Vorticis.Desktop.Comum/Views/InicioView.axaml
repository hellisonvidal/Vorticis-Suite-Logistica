<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Vorticis.Desktop.Comum.ViewModels"
             x:DataType="vm:SuiteViewModel"
             x:Class="Vorticis.Desktop.Comum.Views.InicioView">
    <Design.DataContext>
        <vm:SuiteViewModel />
    </Design.DataContext>

    <Border Background="{DynamicResource PageBackground}" Padding="32">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="24" HorizontalAlignment="Center" MaxWidth="900">
                <Border Background="{DynamicResource AccentBrush}" CornerRadius="12" Padding="32">
                    <StackPanel Spacing="12" HorizontalAlignment="Center">
                        <TextBlock Text="VORTICIS Suite Logística"
                                   FontSize="42" FontWeight="Bold"
                                   Foreground="White" TextAlignment="Center"/>
                        <TextBlock Text="Gestão Completa: Frota, Faturamento, Compras, Gestão, Contábil e Fiscal"
                                   FontSize="18" Foreground="White" Opacity="0.9" TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding Saudacao}"
                           FontSize="22" FontWeight="Medium"
                           Foreground="{DynamicResource TextPrimary}"
                           TextAlignment="Center"/>
                <TextBlock Text="{Binding Hoje}"
                           FontSize="16" Foreground="{DynamicResource TextSecondary}"
                           TextAlignment="Center"/>

                <Border Background="{DynamicResource CardBackground}" CornerRadius="8" Padding="24" Margin="0,16,0,0">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Módulos Disponíveis" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                        <ItemsControl ItemsSource="{Binding Modulos}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" ItemWidth="260" ItemHeight="140"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ModuloSuite">
                                    <Border Classes="CardModuloPequeno"
                                            Background="{Binding Cor}"
                                            BorderBrush="{Binding CorBarra}"
                                            BorderThickness="2"
                                            IsHitTestVisible="{Binding Vm.Logado}"
                                            Opacity="{Binding Vm.Logado, Converter={x:Static ObjectConverters.BoolToOpacity}}"
                                            Margin="8">
                                        <Border.InputBindings>
                                            <MouseBinding Command="{Binding $parent[UserControl].DataContext.TrocarCommand}"
                                                          CommandParameter="{Binding}"
                                                          Gesture="LeftClick"/>
                                        </Border.InputBindings>
                                        <StackPanel Margin="16" Spacing="8">
                                            <TextBlock Text="{Binding Nome}" FontSize="16" FontWeight="Bold" Foreground="White"/>
                                            <TextBlock Text="{Binding Subtitulo}" FontSize="12" Foreground="White" Opacity="0.8" TextWrapping="Wrap"/>
                                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                                                <ItemsControl ItemsSource="{Binding Atalhos}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:NoSuite">
                                                            <TextBlock Text="{Binding Titulo}" FontSize="11" Foreground="White" Opacity="0.8"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>