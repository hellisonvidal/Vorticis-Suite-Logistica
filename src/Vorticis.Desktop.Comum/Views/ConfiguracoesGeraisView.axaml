<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Vorticis.Desktop.Comum.ViewModels"
             xmlns:v="using:Vorticis.Desktop.Comum.Views"
             x:Class="Vorticis.Desktop.Comum.Views.ConfiguracoesGeraisView"
             x:DataType="vm:ConfiguracoesGeraisViewModel">
  <StackPanel Margin="12" Spacing="10" MaxWidth="760" HorizontalAlignment="Left">
    <TextBlock Classes="titulo" Text="Configurações gerais" />
    <TextBlock Text="Somente o administrador altera estas configurações." Classes="erro" IsVisible="{Binding !PodeAlterar}" />
    <StackPanel Spacing="8" IsVisible="{Binding PodeAlterar}">
      <TextBlock Text="Senha de administrador" FontWeight="SemiBold" Foreground="#1F3A5F" />
      <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="Gray"
                 Text="Pedida para restaurar backups e limpar o banco de dados. A senha inicial é VORTICIS — troque-a." />
      <TextBlock Classes="erro" IsVisible="{Binding SenhaPadraoEmUso}"
                 Text="A senha de administrador ainda é a padrão (VORTICIS). Recomenda-se trocá-la." />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBox Text="{Binding SenhaAtual}" PasswordChar="●" Watermark="Senha atual" Width="150" />
        <TextBox Text="{Binding NovaSenha}" PasswordChar="●" Watermark="Nova senha" Width="150" />
        <TextBox Text="{Binding ConfirmacaoNovaSenha}" PasswordChar="●" Watermark="Confirmar" Width="150" />
        <Button Content="Alterar senha" Command="{Binding AlterarSenhaAdministradorCommand}" />
      </StackPanel>
    </StackPanel>

    <Border BorderBrush="#E0A3A0" BorderThickness="1" Background="#FDF3F2" CornerRadius="4" Padding="12" Margin="0,16,0,0"
            IsVisible="{Binding PodeAlterar}">
      <StackPanel Spacing="8">
        <TextBlock Text="Limpar banco de dados (NÃO RECOMENDADO)" FontWeight="SemiBold" Foreground="#B3261E" />
        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#5A2A27"
                   Text="Apaga definitivamente TODAS as empresas e a escrituração (lançamentos, planos, períodos, imobilizado, clientes, fornecedores), contadores, escritórios, tabelas do plano referencial, layouts, usuários e perfis personalizados. Depois de digitar LIMPAR, o sistema pede a senha de administrador; ao final volta à tela de login, como numa instalação nova: só entra o usuário de implantação (vorticis / vorticis), que cadastra o administrador. Use apenas para recomeçar do zero — um backup é gerado antes." />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Digite LIMPAR para confirmar:" VerticalAlignment="Center" />
          <TextBox Text="{Binding ConfirmacaoLimpeza}" Width="120" />
          <Button Content="Limpar banco de dados" Command="{Binding LimparBancoCommand}" Background="#B3261E" Foreground="White" />
        </StackPanel>
      </StackPanel>
    </Border>
    <v:MensagensView />
  </StackPanel>
</UserControl>
