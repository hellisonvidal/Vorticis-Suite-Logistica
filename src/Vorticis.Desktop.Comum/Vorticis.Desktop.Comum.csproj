<Project Sdk="Microsoft.NET.Sdk">
  <!-- Casco comum dos executáveis da suíte (Contábil, Fiscal, Folha): bootstrap, janela principal com menu fornecido
       pelo módulo, login, conexão com o banco, empresas, usuários, perfis, certificados, backup, configurações etc. -->
  <PropertyGroup>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <!-- Ícones dos módulos (usados nas janelas; cada executável usa o seu, ver IModuloDesktop.NomeExecutavel) -->
    <AvaloniaResource Include="..\..\instalador\icone\VorticisContabil.ico" Link="Assets\VorticisContabil.ico" />
    <AvaloniaResource Include="..\..\instalador\icone\VorticisFiscal.ico" Link="Assets\VorticisFiscal.ico" />
    <AvaloniaResource Include="..\..\instalador\icone\VorticisFolha.ico" Link="Assets\VorticisFolha.ico" />
    <AvaloniaResource Include="..\..\instalador\icone\VorticisEscritorio.ico" Link="Assets\VorticisEscritorio.ico" />
    <AvaloniaResource Include="..\..\instalador\icone\VorticisGerencial.ico" Link="Assets\VorticisGerencial.ico" />
    <AvaloniaResource Include="..\..\instalador\icone\VorticisCondominio.ico" Link="Assets\VorticisCondominio.ico" />
    <AvaloniaResource Include="..\..\instalador\icone\VorticisFrota.ico" Link="Assets\VorticisFrota.ico" />
    <AvaloniaResource Include="..\..\instalador\icone\VorticisLogistica.ico" Link="Assets\VorticisLogistica.ico" />
  </ItemGroup>
  <ItemGroup>
    <!-- Manual do usuário (Ajuda › Manual do usuário): os .md e o mapa tela → tópico (F1) vão como recurso embutido -->
    <EmbeddedResource Include="..\..\docs\manual\*.md;..\..\docs\manual\mapa.txt" LogicalName="Manual/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Vorticis.Infra\Vorticis.Infra.csproj" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Controls.DataGrid" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Vorticis.Desktop.Tests" />
  </ItemGroup>
</Project>
